# ─────────────────────────────────────────────────────────────────────────────
# העתק קובץ זה ל-.env.local ומלא לפחות מפתח אחד.
#   cp .env.local.example .env.local
# .env.local נשאר רק על המחשב שלך (חסום ב-.gitignore) ולא נשלח ל-GitHub/Vercel.
# באפליקציה החיה ב-Vercel: הגדר את אותם משתנים ב-
#   Vercel Dashboard → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Mapbox (חובה למפה) ──────────────────────────────────────────────────────
# הטוקן מוזן דרך מסך ההתחלה של האפליקציה (localStorage), לא כאן.

# ── ספק ה-AI למדריך הקולי ────────────────────────────────────────────────────
# הגדר לפחות מפתח אחד. Gemini הוא ברירת המחדל המומלצת — יש לו שכבה חינמית
# משמעותית, וגם הקול (TTS) שלו זול/חינמי יותר מ-OpenAI. מפתח Gemini מתקבל
# ב-https://aistudio.google.com (Get API key) — לא ב-Google Cloud Console.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# בחירת ספק ברירת מחדל: openai | gemini | claude (המשתמש יכול לעקוף בהגדרות האפליקציה)
AI_PROVIDER=gemini

# ── הקראה קולית (TTS) ────────────────────────────────────────────────────────
# סדר העדיפויות: ElevenLabs → OpenAI/Gemini → קול הדפדפן (speechSynthesis).
# ל-Claude אין TTS כלל.
#
# ElevenLabs הוא הספק המומלץ: הוא היחיד כאן שההגייה העברית שלו טובה מספיק
# לקריינות. עברית נתמכת רק במודל Eleven v3 ($0.10 ל-1,000 תווים, קרדיט לתו);
# Multilingual v2 ו-Flash v2.5 זולים יותר אך אינם תומכים בעברית.
# התוכנית החינמית נותנת 10,000 קרדיטים לחודש — בערך מסלול מלא אחד.
#
# ELEVENLABS_VOICE_ID: בחר קול מה-Voice Library (elevenlabs.io → Voices),
# האזן לו בעברית, והדבק כאן את ה-ID שלו. אין ברירת מחדל — בלי ה-ID הספק כבוי.
# הקול שנבחר לפרויקט הזה: 6Mo5ciGH5nWiQacn5FYk
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=6Mo5ciGH5nWiQacn5FYk
# ELEVENLABS_MODEL_ID=eleven_v3          # רק v3 תומך בעברית
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64  # mp3_44100_192 דורש מנוי Creator

# ── Supabase — כניסה עם Google + אזור אישי (אופציונלי) ──────────────────────
# בלי ההגדרות האלה האפליקציה עובדת רגיל, פשוט בלי כפתור התחברות.
# 1. צור פרויקט ב-https://supabase.com (חינם)
# 2. Settings → API: העתק את ה-URL ואת ה-anon public key לכאן
# 3. הרץ את supabase/schema.sql ב-SQL Editor
# 4. Authentication → Providers → Google: הפעל (דורש OAuth client מ-Google Cloud)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase מקפיא פרויקטים חינמיים אחרי 7 ימים ללא פעילות. vercel.json מגדיר
# cron יומי ל-/api/keepalive שמבצע קריאה אחת קטנה ומונע את ההקפאה. הגדר סוד
# כדי שרק ה-cron של Vercel יוכל לקרוא ל-route (Vercel שולח אותו אוטומטית
# ככותרת Authorization: Bearer). בלי הסוד ה-route פתוח — לא מסוכן, אבל פחות נקי.
# CRON_SECRET=

# ── cache קבוע לקריינות (אופציונלי, אך זה מה שחוסך את הכסף) ──────────────────
# בלי המפתח הזה הקריינות נשמרת רק בזיכרון של מכונת השרת ונמחקת עם כל deploy או
# instance חדש — כלומר משלמים שוב על כל השמעה. איתו, כל נקודה משולמת פעם אחת
# בחיים: הסיור הווירטואלי לבדיקת המסלול וההליכה בשטח מנגנים את אותו קובץ.
#
# הטבלאות גלובליות ולא שייכות למשתמש, ולכן הן דורשות מפתח שאינו של משתמש
# מסוים. המפתח נקרא רק בצד השרת ורק ב-src/lib/narrationCache.ts.
# Supabase Dashboard → Settings → API → service_role (secret)
# אזהרה: המפתח הזה עוקף RLS. לעולם אל תשים אותו במשתנה עם קידומת NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── מכסה יומית להגנה מפני עלויות (אופציונלי — יש ברירות מחדל סבירות) ─────────
# פגיעה ב-cache לא עולה כלום ולכן לא נספרת בכלל. נספר רק מה שסונתז באמת.
# למשתמש מחובר (דרך Supabase): תקציב תווים ליום — זה מה שספק ה-TTS מחייב עליו.
# 12,000 תווים ≈ 18 קריינויות חדשות, כלומר יותר ממסלול שלם.
# GUIDE_DAILY_CHARS_PER_USER=12000
# למי שלא מחובר: מכסה לפי IP, ונספרת בקריינויות חדשות (לא בתווים).
# GUIDE_DAILY_MISSES_ANON=8

# ── Upstash Redis — הגבלת קצב גלובלית קשיחה (אופציונלי אך מומלץ בהפצה רחבה) ──
# בלי זה ההגבלה היא "לפי מכונת שרת" (best-effort). עם Upstash היא אמיתית וחוצה
# את כל מכונות ה-Vercel. חינמי בהיקף הזה.
# 1. https://console.upstash.com → Create Database (Redis, Regional, Free)
# 2. בעמוד ה-DB → REST API: העתק את שני הערכים לכאן
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── עקיפת מודלים/קולות (אופציונלי — יש ברירות מחדל טובות) ──────────────────────
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=nova            # nova | alloy | shimmer | ...
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore            # Kore | Puck | Charon | ...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # claude-sonnet-5 איכותי יותר, יקר יותר
