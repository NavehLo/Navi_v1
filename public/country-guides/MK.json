:[20.6473,40.8411,21.1083,41.1894]},"places":[{"name":"Ohrid","lon":20.8018,"lat":41.117},{"name":"Trpejca","lon":20.783,"lat":40.9605},{"name":"Sveti Naum","lon":20.7425,"lat":40.9135},{"name":"Lipova Livada","lon":20.8287,"lat":40.9538},{"name":"Magaro","lon":20.8206,"lat":40.9332},{"name":"Spiridon","lon":20.8301,"lat":40.9516},{"name":"Resen","lon":21.0131,"lat":41.0901}]},{"name":"יאקופיצה וסולונסקה גלאבה","nameLatin":"Jakupica","where":"מרכז המדינה, בין עמק באבונה לעמק ורדאר","body":"יאקופיצה היא מסיב ההרים המרכזי של המדינה, גדול, מורכב והרבה פחות מתויר מארבעת הפארקים הלאומיים. מסלול הגישה המקובל מתחיל בכפר Papradište או ב-Nežilovo ועולה לבקתת Čeples, ומשם לפסגת Solunska Glava. הקיץ והסתיו היבש הם העונה המתאימה; בגשם ובשלג הקטע הסלעי העליון מסוכן. בבקתת Čeples יש כ-60 מיטות, והיא מאפשרת פיצול הגיוני ליומיים. זהו יעד למטיילים בכושר גבוה עם ניסיון במסלולי הרים; אינו מתאים למסלול קצר מסקופיה או למטיילים שמסתמכים על תחבורה ציבורית בלבד.","sources":[21,22,23],"trails":[{"name":"Čeples to Solunska Glava","nameLatin":"Čeples to Solunska Glava","aliases":["Solunska Glava from Cheples Hut","Solunska Glava"],"body":"עלייה קלאסית מבקתת Čeples אל Solunska Glava, כ-6 קמ לכל כיוון או כ-3 שעות ו-30 דקות לכיוון לפי המקורות. היום המלא הלוך-חזור אורך כ-8 שעות. הקטע האחרון עובר בסלע תלול; אין לצאת אליו בגשם או בשלג, והפסגה עצמה סגורה בשל מתקן צבאי כך שמגיעים סמוך לה.","sources":[21,22,24],"start":[21.4286,41.664],"wmt":null,"line":null},{"name":"Papradište to Čeples","nameLatin":"Papradište to Čeples","aliases":["Papradište – Čeples Mountain Hut"],"body":"מסלול גישה מ-Papradište, בגובה 983 מ', לבקתת Čeples בגובה כ-1,407–1,445 מ': 7.5 קמ וכ-3 שעות. הוא עובר בדרכי ג'יפים וביער; זהו מקטע מתאים ליום הראשון של טרק לפסגה.","sources":[22,23],"start":[21.4394,41.6421],"wmt":null,"line":null},{"name":"Papradište – Čeples – Solunska Glava","nameLatin":"Papradište – Čeples – Solunska Glava","aliases":["Solunska Glava from Papradište"],"body":"מסלול יום ארוך או טרק עם לילה בבקתה: מ-Papradište דרך Čeples אל Solunska Glava וחזרה. רישום GPS אחד מתאר 18.24 מייל ו-5,705 רגל טיפוס ומדרג אותו קשה מאוד; יש מים ב-Dolna Babina Dupka אך אחריה יש לתכנן מים מראש.","sources":[24],"start":[21.4394,41.6421],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[21.308,41.7039],[21.3113,41.6852],[21.3209,41.6677],[21.3561,41.6059],[21.3884,41.5571],[21.4037,41.5421],[21.4236,41.5306],[21.4468,41.5234],[21.4717,41.5209],[21.4966,41.5234],[21.5198,41.5306],[21.5397,41.5421],[21.555,41.5571],[21.5646,41.5746],[21.5679,41.5933],[21.5646,41.612],[21.5468,41.6687],[21.5372,41.6862],[21.4875,41.7401],[21.4722,41.7551],[21.4523,41.7666],[21.4291,41.7738],[21.4042,41.7763],[21.3793,41.7738],[21.3561,41.7666],[21.3362,41.7551],[21.3209,41.7401],[21.3113,41.7226],[21.308,41.7039]]]],"bbox":[21.308,41.5209,21.5679,41.7763]},"places":[{"name":"Papradište","lon":21.4394,"lat":41.6421},{"name":"Nežilovo","lon":21.4539,"lat":41.65},{"name":"Čeples","lon":21.4286,"lat":41.664},{"name":"Solunska Glava","lon":21.4042,"lat":41.7039},{"name":"Bogomila","lon":21.4717,"lat":41.5933}]},{"name":"סקופיה, וודנו וקניון מטקה","nameLatin":"Vodno and Matka Canyon","where":"דרום-מערב סקופיה, לאורך נהר טרסקה","body":"זהו אזור היום הנגיש ביותר מהבירה: הר וודנו מעל העיר וקניון מטקה המוגן יוצרים מסלולי רכס, יער וקניון. הוא מתאים בעיקר לחצי יום או יום מלא ולא לטרק רב-יומי; לנים בסקופיה או ליד Matka. העומס גבוה יותר סביב האגם והסכר, במיוחד בסופי שבוע, בעוד המסלול הארוך מוודנו למטקה דורש ניווט, מים והסעה חזרה. בקיץ יש חום, קרקע רופפת וחשיפה בחלקים מהירידה; יש לבדוק איסורי אש, סגירות שבילים וסכנת מפולות סלעים.","sources":[25,26],"trails":[{"name":"Millennium Cross to Matka","nameLatin":"Millennium Cross to Matka","aliases":["Vodno–Matka","Vodno to Matka Canyon"],"body":"ירידה מרכס וודנו ומ-Millennium Cross אל אזור הגשר במטקה: כ-11–12 קמ וכ-4 שעות; עד האגם והסכר יש להוסיף כ-1.5 קמ. המסלול המלא עם העלייה לוודנו מגיע לרוב ל-17–20 קמ ומעלה ול-6–8 שעות. הוא מאומץ מהנראה, עם ירידות תלולות, קרקע רופפת ומים מוגבלים.","sources":[25],"start":[21.3944,41.965],"wmt":null,"line":null},{"name":"Dolna Matka to Rasa","nameLatin":"Dolna Matka to Rasa","aliases":["Matka Canyon – Rasa","Osoj Mountain"],"body":"מסלול מקניון Dolna Matka אל פסגת Rasa בהר Osoj. הוא אחד מחמשת מסלולי ההליכה והטיפוס המתועדים במדריך מטקה; יש להצליב מסלול GPS עדכני ותנאי גישה לפני היציאה.","sources":[26],"start":[21.3052,41.9677],"wmt":null,"line":null},{"name":"Šiševo to Kale","nameLatin":"Šiševo to Kale","aliases":["Šiševo – Kale Fortress","Vodno Kale"],"body":"מסלול מ-Šiševo אל פסגת מצודת Kale בוודנו, המתואר במדריך שבילי מטקה. מתאים כהרחבה הררית של ביקור בקניון, אך אינו מסלול מוכוון-מטיילים עם נתוני מרחק וזמן מאומתים במקור.","sources":[],"start":[21.31,41.9755],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[21.1497,41.9407],[21.153,41.922],[21.1627,41.9045],[21.178,41.8895],[21.1981,41.878],[21.2214,41.8708],[21.2464,41.8683],[21.3056,41.8668],[21.3306,41.8693],[21.4194,41.8951],[21.4427,41.9023],[21.4628,41.9138],[21.5003,41.945],[21.5156,41.96],[21.5253,41.9775],[21.5286,41.9962],[21.5253,42.0149],[21.5156,42.0324],[21.5003,42.0474],[21.4802,42.0589],[21.4569,42.0661],[21.4319,42.0686],[21.3178,42.0651],[21.2928,42.0626],[21.2695,42.0554],[21.2494,42.0439],[21.178,41.9919],[21.1627,41.9769],[21.153,41.9594],[21.1497,41.9407]]]],"bbox":[21.1497,41.8668,21.5286,42.0686]},"places":[{"name":"Skopje","lon":21.4319,"lat":41.9962},{"name":"Vodno","lon":21.4141,"lat":41.9873},{"name":"Millennium Cross","lon":21.3944,"lat":41.965},{"name":"Matka Canyon","lon":21.3178,"lat":41.9927},{"name":"Dolna Matka","lon":21.3052,"lat":41.9677},{"name":"Matka Lake","lon":21.3056,"lat":41.9392},{"name":"Šiševo","lon":21.31,"lat":41.9755},{"name":"Rasa","lon":21.2464,"lat":41.9407}]},{"name":"מלאשבו, ברובו ואוסוגובו","nameLatin":"Maleševo and Osogovo","where":"מזרח וצפון-מזרח המדינה, סמוך לגבול בולגריה","body":"האזורים המיוערים של מלאשבו, סביב Berovo ו-Pehčevo, ורכס אוסוגובו מציעים הליכות שקטות יותר, בגבהים נמוכים יחסית מהמערב ובאקלים יבשתי. הם מתאימים בעיקר למסלולי יום ביער, סביב אגם ברובו ובפסגות הגבול; Berovo היא בסיס הלינה הברור. אפשר ללכת ברוב השנה, אך שלג בחורף והחום בעמק בקיץ משנים את התנאים. העומס נמוך, אך גם הסימון והתחבורה בין ראשי המסלול אינם אחידים. זהו יעד טוב למי שמעדיף יער וטיולי יום שקטים; חלש יותר ממאברובו או שאר כיעד לטרק הררי ארוך עם בקתות.","sources":[27,28],"trails":[{"name":"Berovo Lake – Dvorishte – Bela Voda","nameLatin":"Berovo Lake – Dvorishte – Bela Voda","aliases":["Babin Chukar Trail","Berovo Lake to Bela Voda"],"body":"מסלול מ-Berovo Lake דרך Dvorishte אל Bela Voda: 20 קמ, כ-5 שעות ו-453 מ' עלייה. הוא מדורג קשה, עובר ביער וב-Babin Chukar בגובה 1,403 מ', ומתאים ליום מלא עם נעלי הליכה, מים וביגוד שכבות.","sources":[27],"start":[22.908,41.6674],"wmt":null,"line":null},{"name":"Ruen Peak loop","nameLatin":"Ruen Peak loop","aliases":["Prevala Shelter – Ruen Peak loop","Osogovo Ruen"],"body":"לולאה מ-Prevala Shelter אל פסגת Ruen בהרי אוסוגובו: 25.3 קמ וכ-7 שעות ו-30 דקות. המקור מדרג אותה כמסלול עם עלייה מאתגרת; יש להתייחס אליה כיום ארוך ולא להסתמך על שירותים בשטח.","sources":[28],"start":null,"wmt":null,"line":null},{"name":"Pehčevo Adventure","nameLatin":"Pehčevo Adventure","aliases":["Petko’s Trail","Pehčevo – Petko’s Trail"],"body":"שביל חינוכי באזור Pehčevo, המופיע כמסלול הליכה משמעותי במדריך אזור ברגלניצה. הוא מתאים יותר לטיול יום קצר באזור המיוער מאשר לטרק רב-יומי; יש להשיג נתיב עדכני במקום.","sources":[],"start":[22.8873,41.7636],"wmt":null,"line":null}],"shape":{"kind":"units","polygons":[[[[22.985,41.677],[22.936,41.626],[22.934,41.585],[22.949,41.561],[22.944,41.523],[22.926,41.519],[22.853,41.517],[22.772,41.537],[22.738,41.568],[22.676,41.574],[22.688,41.613],[22.65,41.631],[22.632,41.617],[22.626,41.641],[22.645,41.684],[22.625,41.696],[22.621,41.727],[22.663,41.743],[22.674,41.807],[22.758,41.789],[22.786,41.728],[22.861,41.731],[22.985,41.677]]],[[[22.882,41.872],[22.901,41.86],[22.946,41.769],[22.991,41.761],[23.009,41.74],[22.999,41.693],[22.985,41.677],[22.818,41.737],[22.786,41.728],[22.758,41.789],[22.812,41.81],[22.882,41.872]]]],"bbox":[22.621,41.517,23.009,41.872]},"places":[{"name":"Berovo","lon":22.8536,"lat":41.7067},{"name":"Berovo Lake","lon":22.908,"lat":41.6674},{"name":"Dvorishte","lon":22.9143,"lat":41.5901},{"name":"Pehčevo","lon":22.8873,"lat":41.7636},{"name":"Ruen","lon":22.4282,"lat":41.9171}]}],"closing":"לבחירה לפי מאמץ: מאברובו, שאר ויאקופיצה מתאימים ליום פסגה קשה או לכמה ימי הליכה, עם צורך גדול יותר בלוגיסטיקה ובניסיון; פליסטר מאפשר את הפיצול הנוח ביותר לבקתה; גליצ'יצה טובה ליום רכס חשוף מעל אגמים; וודנו–מטקה טובים ליום מסקופיה; ומלאשבו–אוסוגובו למי שמעדיף יער ושקט. למסלולי הגובה כדאי לכוון בעיקר מיוני עד ספטמבר או נובמבר לפי הפארק, ולבדוק סמוך ליציאה שלג, שרפות, רישום והגבלות מקומיות.","closingSources":[1,5,14,25],"sources":[{"id":1,"url":"https://northmacedoniatourism.com/things-to-do/hiking","title":"Hiking in North Macedonia | North Macedonia Tourism"},{"id":2,"url":"https://nationalparks.mk/","title":"National Parks R.N. Macedonia"},{"id":3,"url":"https://www.cicerone.co.uk/hiking-the-high-scardus-trail-a-complete-planning-guide","title":"High Scardus Trail: Complete Planning Guide | Cicerone Press"},{"id":4,"url":"https://nationalparks.mk/en/np-mavrovo.html","title":"Mavrovo National Park"},{"id":5,"url":"https://npmavrovo.org.mk/en/%D0%BF%D0%BB%D0%B0%D0%BD%D0%B8%D1%80%D0%B0%D1%9A%D0%B5-%D0%B8-%D0%BF%D0%BB%D0%B0%D0%BD%D0%B8%D0%BD%D1%81%D0%BA%D0%B8-%D0%B2%D0%B5%D0%BB%D0%BE%D1%81%D0%B8%D0%BF%D0%B5%D0%B4%D0%B8%D0%B7%D0%B0%D0%BC/","title":"Hiking and mountain biking | National Park Mavrovo"},{"id":6,"url":"https://macedoniaguidebook.com/attractions/mavrovo-national-park/","title":"Mavrovo National Park | North Macedonia Guidebook"},{"id":7,"url":"https://northmacedoniatourism.com/things-to-do/hiking","title":"Hiking in North Macedonia | North Macedonia Tourism"},{"id":8,"url":"https://nationalparks.mk/en/np-sarplanina.html","title":"Shar Mountain National Park"},