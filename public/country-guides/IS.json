753],[-19.4596,63.5749],[-19.4628,63.5723],[-19.4706,63.5708],[-19.4766,63.5709],[-19.4898,63.5661],[-19.4904,63.5646],[-19.4869,63.5617],[-19.4907,63.5586],[-19.4927,63.5506],[-19.501,63.5448],[-19.499,63.5429],[-19.5018,63.5387],[-19.4998,63.5369],[-19.5017,63.5352],[-19.5044,63.535],[-19.5052,63.5335],[-19.5098,63.5323],[-19.5117,63.5301]],[[-19.4409,63.611],[-19.4339,63.6113],[-19.4315,63.6106],[-19.4336,63.6058]]]},{"name":"Skógar–Baldvinsskáli","nameLatin":"Skógar–Baldvinsskáli","aliases":["Fimmvörðuháls lower section","Skógá Trail"],"body":"הקטע הראשון של Fimmvörðuháls מ-Skógar ל-Baldvinsskáli: 12 קמ', 4–5 שעות וכ-1,000 מ' עלייה. מתאים למטיילים שרוצים יום עליות ומפלים בלי להשלים את כל החצייה, אך דורש כושר וציוד למזג אוויר הררי.","sources":[11],"start":[-19.4944,63.527],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[-19.6836,63.6867],[-19.657,63.527],[-19.6514,63.5083],[-19.6352,63.4908],[-19.6094,63.4758],[-19.5757,63.4643],[-19.5365,63.4571],[-19.4944,63.4546],[-19.4523,63.4571],[-19.4131,63.4643],[-19.3794,63.4758],[-19.3536,63.4908],[-18.9197,63.9543],[-18.9035,63.9718],[-18.8979,63.9905],[-18.9035,64.0092],[-18.9197,64.0267],[-18.9455,64.0417],[-18.9792,64.0532],[-19.0184,64.0604],[-19.0605,64.0629],[-19.1026,64.0604],[-19.1418,64.0532],[-19.1755,64.0417],[-19.2958,63.9842],[-19.3216,63.9692],[-19.6618,63.7229],[-19.678,63.7054],[-19.6836,63.6867]]]],"bbox":[-19.6836,63.4546,-18.8979,64.0629]},"places":[{"name":"Landmannalaugar","lon":-19.0605,"lat":63.9905},{"name":"Hrafntinnusker","lon":-19.1808,"lat":63.933},{"name":"Emstrur","lon":-19.3732,"lat":63.7664},{"name":"Þórsmörk","lon":-19.521,"lat":63.6867},{"name":"Fimmvörðuháls","lon":-19.4407,"lat":63.6215},{"name":"Skógar","lon":-19.4944,"lat":63.527}]},{"name":"החוף הדרומי וסקאפטאפל","nameLatin":"South Coast and Skaftafell","where":"דרום-מזרח איסלנד, סביב Skaftafell ו-Öræfi","body":"Skaftafell הוא אזור ההליכה המפותח ביותר לאורך החוף הדרומי: שבילים מסומנים יוצאים ממרכז המבקרים אל מפלים, לשונות קרח, יער ומדרונות ההרים של Öræfi. הוא מתאים במיוחד למי שרוצה לבחור בין מסלול קצר למסלול יום קשה בלי לשאת ציוד לטרק. יש קמפינג גדול במקום, שירותי מבקרים וגישה מכביש 1; אפשר ללון גם ב-Kirkjubæjarklaustur או Höfn. המסלולים הקצרים עמוסים בעונה, ואילו העליות ל-Skaftafellsheiði ול-Kristínartindar שקטות ותובעניות יותר. האזור נגיש כל השנה בתלות במזג האוויר, אך מסלולים גבוהים עשויים להיסגר באביב ועד סוף יוני בשל הפשרה.","sources":[13,14,15],"trails":[{"name":"Svartifoss – Sjónarsker – Sel","nameLatin":"Svartifoss – Sjónarsker – Sel","aliases":["S2 Svartifoss","Svartifoss loop"],"body":"לולאה מ-Skaftafellsstofa אל Svartifoss, 5.8 קמ' וכשעתיים, בדרגת קושי קלה לפי הפארק. מתאים כטיול יום קצר; זהו אחד השבילים הנגישים והעמוסים יותר באזור.","sources":[13],"start":[-16.9663,64.0167],"wmt":{"type":"relation","id":5449040,"name":"Svartifoss - Sjónarsker - Sel","group":"LOC","linear":"yes"},"line":[[[-16.9672,64.0163],[-16.9749,64.0173],[-16.9796,64.0195],[-16.9795,64.0215],[-16.9733,64.0261],[-16.9747,64.0269],[-16.9815,64.0259],[-16.9821,64.024],[-16.9916,64.0234],[-16.9857,64.0214],[-16.9811,64.0211],[-16.9813,64.018],[-16.9829,64.0172],[-16.9782,64.0164],[-16.9672,64.0163]]]},{"name":"Skaftafellsheiði","nameLatin":"Skaftafellsheiði","aliases":["S3 Skaftafellsheiði","Skaftafell Heath"],"body":"לולאה מ-Skaftafellsstofa, 16.6 קמ' ו-5–6 שעות, בדרגת קושי מאתגרת. המסלול עולה אל הרמה מעל היער; באביב הוא עלול להיסגר עקב בוץ והפשרה.","sources":[13,15],"start":[-16.9663,64.0167],"wmt":{"type":"relation","id":5451031,"name":"Skaftafellsheiði","group":"LOC","linear":"yes"},"line":[[[-16.9672,64.0163],[-16.9724,64.0167],[-16.9773,64.0183],[-16.9784,64.0196],[-16.9796,64.0195],[-16.9793,64.0213],[-16.981,64.0213],[-16.9801,64.0229],[-16.9819,64.0243],[-16.9825,64.0278],[-16.9766,64.0325],[-16.9738,64.0403],[-16.9683,64.0449],[-16.9763,64.0515],[-16.9709,64.0568],[-16.9541,64.0623],[-16.9501,64.0648],[-16.9473,64.0651],[-16.936,64.0616],[-16.9406,64.0573],[-16.9398,64.0542],[-16.9335,64.0542],[-16.9202,64.0574],[-16.9225,64.0549],[-16.9212,64.0527],[-16.9254,64.0508],[-16.9283,64.0479],[-16.9288,64.0408],[-16.9375,64.0344],[-16.9382,64.0307],[-16.9469,64.0264],[-16.9518,64.0256],[-16.9534,64.0239],[-16.9514,64.0238],[-16.9589,64.0204],[-16.9724,64.0167],[-16.9672,64.0163]]]},{"name":"Kristínartindar","nameLatin":"Kristínartindar","aliases":["S4 Kristínartindar","Kristín Peaks"],"body":"לולאה מ-Skaftafellsstofa לפסגות Kristínartindar, 17.9 קמ', 6–8 שעות ועלייה של 1,215 מ'. מסלול קשה למנוסים בלבד; הסגירה העונתית יכולה להימשך מתחילת האביב ולעתים עד יוני.","sources":[14],"start":[-16.9663,64.0167],"wmt":{"type":"relation","id":5451032,"name":"Kristínartindar","group":"LOC","linear":"yes"},"line":[[[-16.9672,64.0163],[-16.9749,64.0173],[-16.9796,64.0195],[-16.9789,64.0209],[-16.981,64.0213],[-16.9801,64.0229],[-16.982,64.025],[-16.9825,64.0278],[-16.9766,64.0325],[-16.9738,64.0403],[-16.9683,64.0449],[-16.9763,64.0512],[-16.9745,64.0538],[-16.9709,64.0568],[-16.9541,64.0623],[-16.9501,64.0648],[-16.9463,64.0649],[-16.9385,64.0622],[-16.9336,64.0633],[-16.9297,64.0654],[-16.9257,64.0658],[-16.9272,64.0679],[-16.9261,64.0692],[-16.9268,64.0645],[-16.923,64.065],[-16.922,64.0631],[-16.9203,64.0628],[-16.9231,64.0602],[-16.9198,64.0577],[-16.9225,64.0549],[-16.9212,64.0527],[-16.9254,64.0508],[-16.9283,64.0479],[-16.9288,64.0408],[-16.9375,64.0344],[-16.9382,64.0307],[-16.9469,64.0264],[-16.9518,64.0256],[-16.9534,64.0239],[-16.9514,64.0238],[-16.9589,64.0204],[-16.9724,64.0167],[-16.9672,64.0163]]]}],"shape":{"kind":"hull","polygons":[[[[-17.4225,63.8875],[-17.4169,63.8688],[-17.4006,63.8513],[-17.3745,63.8363],[-17.3405,63.8248],[-17.301,63.8176],[-17.2585,63.8151],[-17.216,63.8176],[-16.7511,63.8745],[-16.7116,63.8817],[-16.6776,63.8932],[-16.6515,63.9082],[-16.6352,63.9257],[-16.6296,63.9444],[-16.6352,63.9631],[-16.7162,64.0811],[-16.7325,64.0986],[-16.7586,64.1136],[-16.7926,64.1251],[-16.8321,64.1323],[-16.8836,64.1392],[-16.9261,64.1417],[-16.9686,64.1392],[-17.0081,64.132],[-17.0421,64.1205],[-17.3745,63.9387],[-17.4006,63.9237],[-17.4169,63.9062],[-17.4225,63.8875]]]],"bbox":[-17.4225,63.8151,-16.6296,64.1417]},"places":[{"name":"Skaftafell","lon":-16.9665,"lat":64.0165},{"name":"Skaftafellsstofa","lon":-16.9663,"lat":64.0167},{"name":"Svartifoss","lon":-16.9753,"lat":64.0277},{"name":"Skaftafellsjökull","lon":-16.8746,"lat":64.0624},{"name":"Kristínartindar","lon":-16.9261,"lat":64.0693},{"name":"Skeiðarársandur","lon":-17.2585,"lat":63.8875},{"name":"Öræfi","lon":-16.7936,"lat":63.9444}]},{"name":"מזרח איסלנד ופיורדי המזרח","nameLatin":"East Iceland and Eastfjords","where":"מ-Egilsstaðir דרך Borgarfjörður Eystri ועד הפיורדים הדרומיים","body":"מזרח איסלנד מציע פיורדים, רכסי ריוליט, יערות ומסלולים מסומנים עם פחות מטיילים מאזורי הדרום. מרכז הטרקים הוא Borgarfjörður Eystri ו-Víknaslóðir, רשת שבילים בין מפרצים נטושים, עמקים ובקתות. העונה הרגילה היא מאמצע יוני עד ספטמבר; שלג יכול להישאר במסלולים הגבוהים עד סוף יולי. לנים בכפרים כמו Egilsstaðir, Seyðisfjörður ו-Borgarfjörður Eystri, בקמפינגים ובבקתות Breiðavík, Húsavík ו-Loðmundarfjörður. זהו אזור מתאים למי שמחפש שקט ומסלולי יום או מסלול של כמה ימים; מזג האוויר המהיר וסימון שקשה לעקוב אחריו בשטח סלעי מחייבים ניווט בסיסי.","sources":[16,17,18],"trails":[{"name":"Víknaslóðir","nameLatin":"Víknaslóðir","aliases":["Trails of the Inlets","Víknaslóðir trails"],"body":"רשת של כ-150 קמ' סביב Borgarfjörður Eystri, Brúnavík, Breiðavík, Húsavík ו-Loðmundarfjörður, עם אפשרויות של יום אחד ועד כמה ימים. יש בקתות ושירותי תכנון והסעה ב-Borgarfjörður Eystri; המסלולים מסומנים אך דורשים היערכות למזג אוויר.","sources":[16],"start":[-13.816,65.5177],"wmt":null,"line":null},{"name":"Brúnavík","nameLatin":"Brúnavík","aliases":["Brúnavík Trail","Borgarfjarðarhöfn to Brúnavík"],"body":"מ-Borgarfjarðarhöfn אל החוף ב-Brúnavík וחזרה: כ-12 קמ' דרך Brúnavíkurskarð בגובה 360 מ', או כ-8 קמ' הלוך ושוב מהחניה לפי תיאור חלופי. זהו מסלול בינוני ומסומן; העונה היא בדרך כלל קיץ.","sources":[16,17],"start":[-13.7536,65.5413],"wmt":{"type":"relation","id":6173459,"name":"Brunavik","group":"REG","linear":"yes"},"line":[[[-13.7563,65.536],[-13.7389,65.5316],[-13.7205,65.5306],[-13.6979,65.5272],[-13.6942,65.528],[-13.6867,65.5266]]]},{"name":"Stórurð","nameLatin":"Stórurð","aliases":["Storurd","Stórurð Boulder Field"],"body":"מ-Vatnsskarð אל שדה הסלעים והבריכות של Stórurð וחזרה, 15 קמ', 4.5–6 שעות ועלייה/ירידה של כ-680 מ'. המסלול בינוני עד קשה, והשלג בגובה מעל 400 מ' עלול לחסום אותו עד סוף יולי.","sources":[17],"start":[-19.6951,65.5091],"wmt":{"type":"relation","id":6223863,"name":"Stórurð","group":"REG","linear":"no"},"line":[[[-13.991,65.5165],[-13.9891,65.5184],[-14.0012,65.5213],[-14.0084,65.5271],[-14.0037,65.5312],[-14.0065,65.5404],[-14.0104,65.5472],[-14.0053,65.5507],[-14.0023,65.5515],[-14.0039,65.5539],[-14.0021,65.5581],[-13.9977,65.5605],[-13.9923,65.5618],[-13.9954,65.5621],[-14.0002,65.5641],[-14.001,65.5673],[-14.0167,65.5629],[-14.0282,65.5575],[-14.0327,65.5573],[-14.0422,65.5533],[-14.0448,65.5488],[-14.0437,65.5445],[-14.0475,65.5384],[-14.0499,65.5376],[-14.0518,65.5353],[-14.0519,65.5319],[-14.0489,65.5283]],[[-13.991,65.5165],[-13.9883,65.5143],[-13.9893,65.5125],[-13.9968,65.5141],[-13.9966,65.5161],[-14.022,65.5157],[-14.0354,65.5172],[-14.0399,65.5183],[-14.0423,65.52],[-14.0446,65.5222],[-14.0451,65.5255],[-14.0489,65.5283]],[[-13.9966,65.5161],[-13.991,65.5165]],[[-14.0024,65.5647],[-13.9978,65.5624],[-13.9968,65.5607]]]}],"shape":{"kind":"hull","polygons":[[[[-14.5769,65.262],[-14.571,65.2433],[-14.5537,65.2258],[-14.5261,65.2108],[-14.4902,65.1993],[-14.4484,65.1921],[-14.4035,65.1896],[-14.3586,65.1921],[-13.7274,65.2793],[-13.6856,65.2865],[-13.6497,65.298],[-13.6221,65.313],[-13.6048,65.3305],[-13.5135,65.5071],[-13.5076,65.5258],[-13.5135,65.5445],[-13.5308,65.562],[-13.5584,65.577],[-13.5943,65.5885],[-13.6361,65.5957],[-13.681,65.5982],[-13.8161,65.5994],[-13.861,65.5969],[-14.0237,65.5819],[-14.0655,65.5747],[-14.1014,65.5632],[-14.129,65.5482],[-14.5537,65.2982],[-14.571,65.2807],[-14.5769,65.262]]]],"bbox":[-14.5769,65.1896,-13.5076,65.5994]},"places":[{"name":"Egilsstaðir","lon":-14.4035,"lat":65.262},{"name":"Borgarfjörður Eystri","lon":-13.816,"lat":65.5177},{"name":"Bakkagerði","lon":-13.8161,"lat":65.527},{"name":"Stórurð","lon":-13.9788,"lat":65.512},{"name":"Brúnavík","lon":-13.681,"lat":65.5258},{"name":"Loðmundarfjörður","lon":-13.7723,"lat":65.3492}]},{"name":"צפון איסלנד: מיוואטן, יוקולסארגליופור ואסקיה","nameLatin":"North Iceland: Mývatn, Jökulsárgljúfur and Askja","where":"צפון-מזרח והפנים הצפוניים","body":"הצפון משלב הליכות קצרות סביב אגם Mývatn ושדות לבה עם מסלולים ארוכים בקניון Jökulsárgljúfur וטיולים מרוחקים בהיילנדס של Askja. סביב Mývatn יש כפרים, מלונות, קמפינג ושבילים לכל העונות, אך יש להיזהר מסדקים בלבה. Jökulsárgljúfur מתאים לטרק של יומיים עם קמפינג מוגבל לאתרים המוסדרים. Askja מרוחקת, דורשת גישה בדרכי F בעונת הקיץ ותכנון עצמאי או תחבורה מאורגנת; בבקתת Dreki ובאתרי הפארק יש שירותים עונתיים. זהו אזור טוב למי שרוצה לשלב טיולי יום ויעד היילנדס, אבל פחות למטייל חסר ניסיון בגישה מרוחקת ובתנאים משתנים.","sources":[19,20,21,22],"trails":[{"name":"Mývatn North Bank Circle","nameLatin":"Mývatn North Bank Circle","aliases":["North Bank Circle","Mývatn Norðurbakkahringur"],"body":"לולאה מ-Reykjahlíð לאורך שפת Mývatn ושדה לבה, 6.67 קמ' ו-2–3 שעות. המסלול מסומן ופתוח בכל העונות, אך יש סדקים נסתרים בלבה וקטעים חלקים.","sources":[22],"start":[-16.91,65.6416],"wmt":null,"line":null},{"name":"Ásbyrgi–Dettifoss Canyon Trail","nameLatin":"Ásbyrgi–Dettifoss Canyon Trail","aliases":["Jökulsárgljúfur Canyon Trail","Ásbyrgi to Dettifoss"],"body":"מ-Gljúfrastofa ב-Ásbyrgi ל-Dettifoss לאורך Jökulsárgljúfur, 32 קמ' ביומיים, בדרגת קושי מאתגרת. אין בקתות; מותר לישון רק בקמפינגים של Vesturdalur ו-Dettifoss, ויש לשאת מי שתייה בחלקים מהמסלול.","sources":[19,20],"start":[-16.4887,66.0282],"wmt":null,"line":null},{"name":"Vikraborgir–Öskjuvatn","nameLatin":"Vikraborgir–Öskjuvatn","aliases":["Askja Víti Trail","Vikraborgir to Öskjuvatn"],"body":"מ-Vikraborgir אל Öskjuvatn ו-Víti, 2.5 קמ' וכשעתיים, מסלול קל לפי הפארק. הירידה ל-Víti עלולה להיות חלקה ובוצית, עם סכנת החלקת אבנים; הגישה לאסקיה עצמה תלויה בתנאי דרכי ההיילנדס.","sources":[21,23],"start":[-16.7292,65.0657],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[-18.2864,65.6839],[-18.2805,65.6652],[-18.2631,65.6477],[-18.2354,65.6327],[-16.8701,64.9792],[-16.834,64.9677],[-16.792,64.9605],[-16.7469,64.958],[-16.7018,64.9605],[-16.6598,64.9677],[-16.6237,64.9792],[-16.596,64.9942],[-16.5786,65.0117],[-16.2162,65.7957],[-16.2103,65.8144],[-16.2162,65.8331],[-16.3439,66.0203],[-16.3613,66.0378],[-16.389,66.0528],[-16.4251,66.0643],[-16.4671,66.0715],[-16.5122,66.074],[-16.5573,66.0715],[-16.5993,66.0643],[-18.1993,65.7466],[-18.2354,65.7351],[-18.2631,65.7201],[-18.2805,65.7026],[-18.2864,65.6839]]]],"bbox":[-18.2864,64.958,-16.2103,66.074]},"places":[{"name":"Akureyri","lon":-18.1122,"lat":65.6839},{"name":"Mývatn","lon":-17.0133,"lat":65.6033},{"name":"Reykjahlíð","lon":-16.91,"lat":65.6416},{"name":"Dimmuborgir","lon":-16.9079,"lat":65.5881},{"name":"Dettifoss","lon":-16.3845,"lat":65.8144},{"name":"Ásbyrgi","lon":-16.5122,"lat":66.0016},{"name":"Askja","lon":-16.7469,"lat":65.0304}]},{"name":"סנייפלסנס ופארק Snæfellsjökull","nameLatin":"Snæfellsnes and Snæfellsjökull National Park","where":"חצי האי במערב איסלנד","body":"Snæfellsnes הוא יעד טוב ליומיים–שלושה של הליכות חוף קצרות, שדות לבה ועליות נקודתיות, ולא יעד מרכזי לטרק רב-יומי רציף. פארק Snæfellsjökull מגיע עד הים ומשלב קרחון, לבה, חופים ומצוקים. לנים ב-Arnarstapi, Hellnar, Ólafsvík, Hellissandur או בקמפינגים; שירותי אוכל ומקומות לינה מרוכזים ביישובים ולא לאורך השבילים. המסלולים הפופולריים בחוף, במיוחד Arnarstapi–Hellnar, עמוסים בקיץ. מתאים למטיילים שרוצים מסלולים קצרים ומגוונים עם גישה ברכב; עליות לקרחון או לפסגות דורשות תנאים טובים וניסיון מתאים.","sources":[24,25,26],"trails":[{"name":"Arnarstapi–Hellnar","nameLatin":"Arnarstapi–Hellnar","aliases":["Arnarstapi Hellnar Coastal Trail","Hellnahraun Trail"],"body":"לאורך החוף מ-Arnarstapi ל-Hellnar, 2.5 קמ' לכיוון וכ-45–60 דקות. המסלול עובר בלבה ובמצוקי החוף; הוא קצר אך מוגדר תובעני במפת הפארק, וחשוף לרוח.","sources":[25,26],"start":[-23.6281,64.7667],"wmt":null,"line":null},{"name":"Djúpalónssandur–Dritvík","nameLatin":"Djúpalónssandur–Dritvík","aliases":["Djúpalónssandur to Dritvík","Dritvík Trail"],"body":"מ-Djúpalónssandur ל-Dritvík, קילומטר אחד וכ-20 דקות לכל כיוון לפי רשימת שבילי הפארק. זהו מסלול חוף קצר; אפשר להמשיך עד Sandhólar למסלול כולל של 4 קמ'.","sources":[24],"start":[-23.9032,64.7521],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[-24.0718,64.7521],[-24.066,64.7334],[-24.0492,64.7159],[-24.0224,64.7009],[-23.9875,64.6894],[-23.886,64.6665],[-23.8453,64.6593],[-23.8017,64.6568],[-23.7581,64.6593],[-23.6033,64.681],[-23.5626,64.6882],[-23.5277,64.6997],[-22.6111,65.0231],[-22.5843,65.0381],[-22.5675,65.0556],[-22.5617,65.0743],[-22.5675,65.093],[-22.5843,65.1105],[-22.6111,65.1255],[-22.646,65.137],[-22.6867,65.1442],[-22.7303,65.1467],[-22.7739,65.1442],[-22.8146,65.137],[-23.3918,65.0026],[-23.8622,64.871],[-23.8971,64.8595],[-24.0224,64.8033],[-24.0492,64.7883],[-24.066,64.7708],[-24.0718,64.7521]]]],"bbox":[-24.0718,64.6568,-22.5617,65.1467]},"places":[{"name":"Stykkishólmur","lon":-22.7303,"lat":65.0743},{"name":"Kirkjufell","lon":-23.3075,"lat":64.9399},{"name":"Arnarstapi","lon":-23.6281,"lat":64.7667},{"name":"Hellnar","lon":-23.6469,"lat":64.7509},{"name":"Lóndrangar","lon":-23.7839,"lat":64.7324},{"name":"Djúpalónssandur","lon":-23.9032,"lat":64.7521},{"name":"Malarrif","lon":-23.8017,"lat":64.7292},{"name":"Snæfellsjökull","lon":-23.7779,"lat":64.8083}]},{"name":"הפיורדים המערביים","nameLatin":"Westfjords","where":"חצי האי הצפון-מערבי, מלבד Hornstrandir","body":"הפיורדים המערביים מציעים הליכות בין פיורדים, רמות עשב ומצוקי ים, עם מרחקי נסיעה ארוכים ושירותים מפוזרים. זהו אזור שקט יותר מדרום איסלנד, אך הכבישים, הרוח והגשם מחייבים זמן גמיש. לנים בעיירות כגון Ísafjörður, Hólmavík ו-Djúpavík, בבתי הארחה ובקמפינגים עונתיים; במסלולים עצמם לעתים אין שירות כלל. Látrabjarg הוא יעד חוף קצר ופופולרי, ואילו Strandir והפיורדים הדרומיים מתאימים למי שמוכן למסלולים עצמאיים. האזור מתאים במיוחד לטיולי יום ולמסלולים על דרכי דואר ישנות; אינו מתאים למי שמוגבל בזמן או רוצה לוגיסטיקה פשוטה של תחבורה ציבורית.","sources":[27,28,29,30],"trails":[{"name":"Gilsfjörður–Bitrufjörður","nameLatin":"Gilsfjörður–Bitrufjörður","aliases":["Þverun Íslands","Gilsfjordur Bitrufjordur Trail"],"body":"דרך דואר ישנה בין Gilsfjörður ל-Bitrufjörður, 4–6 שעות, במסלול מסומן בחלקו. יש מעבר נחל וקטע של כ-3 קמ' בשטח עשב וגבשושי איטי; אין שירותים לאורך הדרך.","sources":[28],"start":[-21.7983,65.4354],"wmt":null,"line":null},{"name":"Djúpuvíkurhringur","nameLatin":"Djúpuvíkurhringur","aliases":["Djúpavík Loop","Djupuvikurhringur"],"body":"לולאה היוצאת מ-Hótel Djúpavík דרך Djúpavíkurfoss, 2–3 שעות. המסלול מסומן וכולל מעבר נחל ועלייה; מתקרבים בזהירות לשפת המצוקים, במיוחד בגשם.","sources":[29],"start":[-23.1055,66.1034],"wmt":null,"line":null},{"name":"Vaðalfjöll","nameLatin":"Vaðalfjöll","aliases":["Vadalfjoll","Vaðalfjöll Trail"],"body":"מ-Hótel Bjarkalundur אל שני סלעי Vaðalfjöll, 2–3 שעות. תחילת השביל קשה לאיתור אך הדרך מסומנת בהמשך; המסלול סביב הפסגות אינו מסומן, והטיפוס לפסגות עצמן תלול ומתאים רק למנוסים.","sources":[30],"start":[-22.104,65.5563],"wmt":null,"line":null}],"shape":{"kind":"units","polygons":[[[[-21.695,65.453],[-21.976,65.44],[-21.935,65.467],[-21.99,65.508],[-22.045,65.501],[-22.04,65.487],[-22.063,65.484],[-22.114,65.529],[-22.111,65.497],[-22.135,65.474],[-22.199,65.432],[-22.254,65.434],[-22.387,65.492],[-22.346,65.515],[-22.165,65.541],[-22.148,65.577],[-22.107,65.597],[-22.244,65.537],[-22.347,65.529],[-22.292,65.555],[-22.312,65.562],[-22.374,65.538],[-22.416,65.549],[-22.409,65.525],[-22.479,65.508],[-22.504,65.529],[-22.501,65.57],[-22.546,65.634],[-22.558,65.625],[-22.547,65.561],[-22.589,65.536],[-2