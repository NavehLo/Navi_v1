7851}]},{"name":"עמק המוזל","nameLatin":"Moselle","where":"מזרח ודרום-מזרח לוקסמבורג, לאורך הגבול עם גרמניה","body":"אזור המוזל הוא אזור הליכה של עמק נהר, כרמים, כפרי יין וגבעות קצרות אך תלולות. הוא מתאים בעיקר למסלולי יום ולמסלולים בני יומיים, ופחות לטרק מבודד ארוך. Schengen הוא נקודת גישה מרכזית למסלולים חוצי גבולות; יש בו מסלולים העוברים גם בצרפת ובגרמניה. הלינה מתאימה בעיקר בכפרי היין ובעיירות לאורך הנהר. אין במקורות נתון על עומס עונתי; במסלולי Dream Loop מצוינים קטעים תלולים וחלקלקים בגשם ובחורף, ולכן הם פחות מתאימים למי שאינו בטוח בהליכה.","sources":[10,11,12],"trails":[{"name":"Moselle³-Trail","nameLatin":"Moselle³-Trail","aliases":["Moselle 3 Trail","M³-Trail"],"body":"לולאה מ-Schengen דרך אזור הגבול של לוקסמבורג, צרפת וגרמניה. המקור מציג אותה כמסלול של 33 קמ, בעוד תיעוד המסלול מציג 33.58 קמ ו-9:25 שעות; הקושי קשה, וניתן לפצל ליומיים. אופני הרים אינם מותרים.","sources":[10],"start":[6.3336,49.4992],"wmt":{"type":"relation","id":13046277,"name":"Moselle³ Trail","group":"LOC","linear":"no"},"line":[[[6.3665,49.4712],[6.3703,49.4717],[6.3728,49.4747],[6.3769,49.4761]],[[6.3665,49.4712],[6.3615,49.4634],[6.3637,49.4546],[6.3626,49.4548],[6.3596,49.4501],[6.3566,49.4483],[6.3536,49.4509],[6.3513,49.4517],[6.3496,49.4504],[6.348,49.4519],[6.3479,49.4494],[6.345,49.4481],[6.3546,49.4417],[6.3599,49.4416],[6.3629,49.4365],[6.3625,49.4355],[6.3604,49.4376],[6.3595,49.4319],[6.3617,49.4304],[6.3615,49.4272],[6.3719,49.4197],[6.3732,49.4209],[6.3808,49.4205],[6.3874,49.4246],[6.3858,49.4305],[6.3884,49.4358],[6.3748,49.4285],[6.3741,49.4302],[6.3742,49.4385],[6.3752,49.4403],[6.3798,49.442],[6.3824,49.4458],[6.3812,49.4467],[6.3817,49.4522],[6.3844,49.4545],[6.3926,49.4538],[6.3873,49.4587],[6.394,49.4586],[6.4019,49.4655],[6.4073,49.4673],[6.4056,49.469],[6.3975,49.4668],[6.3874,49.4663],[6.3875,49.4651],[6.3907,49.4642],[6.3899,49.4633],[6.3798,49.4663],[6.3853,49.4657],[6.4017,49.4699],[6.4014,49.4733],[6.4054,49.4798],[6.4029,49.4813],[6.4048,49.486],[6.4018,49.4882],[6.3975,49.4855],[6.3949,49.4854],[6.3923,49.487],[6.3902,49.4812],[6.3891,49.4822],[6.3819,49.4823],[6.381,49.4809],[6.3754,49.4815],[6.3769,49.4761]],[[6.3461,49.4467],[6.3459,49.4469]]]},{"name":"National hiking trail Schengen-Hellange","nameLatin":"National hiking trail Schengen-Hellange","aliases":["Sentier pédestre national Schengen-Hellange","Schengen-Hellange"],"body":"מ-Schengen ל-Hellange, 25.65 קמ וכ-6:45 שעות, בדרגת קושי בינונית. המסלול עובר בכרמים, שדות, מרעה ויערות, ומגיע לכיוון Mondorf-les-Bains; יש גם אפשרות לסטייה קצרה לצרפת.","sources":[12],"start":[6.3336,49.4992],"wmt":null,"line":null},{"name":"Auto-pedestrian hiking trail Schengen","nameLatin":"Auto-pedestrian hiking trail Schengen","aliases":["Circular walk Schengen","Schengen Auto-Pédestre"],"body":"לולאה ממרכז Schengen, 5.4 קמ וכ-1:30 שעות, קלה. המסלול עולה מן המוזל דרך כרמים אל Stromberg ו-Markusberg וחוזר לעיירה; מתאים למי שמחפש מסלול קצר ולא טרק.","sources":[11],"start":[6.3336,49.4992],"wmt":null,"line":null}],"shape":{"kind":"units","polygons":[[[[6.296,49.849],[6.303,49.835],[6.334,49.84],[6.397,49.809],[6.503,49.796],[6.486,49.734],[6.5,49.712],[6.403,49.656],[6.418,49.639],[6.351,49.567],[6.345,49.463],[6.325,49.457],[6.251,49.489],[6.235,49.54],[6.241,49.562],[6.301,49.594],[6.285,49.609],[6.312,49.627],[6.286,49.674],[6.175,49.69],[6.22,49.737],[6.263,49.747],[6.275,49.77],[6.246,49.791],[6.266,49.812],[6.256,49.828],[6.296,49.849]]]],"bbox":[6.175,49.457,6.503,49.849]},"places":[{"name":"Schengen","lon":6.3336,"lat":49.4992},{"name":"Remich","lon":6.3676,"lat":49.5442},{"name":"Grevenmacher","lon":6.4112,"lat":49.677},{"name":"Manternach","lon":6.4087,"lat":49.7218},{"name":"Wasserbillig","lon":6.5013,"lat":49.7143},{"name":"Mondorf-les-Bains","lon":6.2737,"lat":49.5136},{"name":"Strombierg","lon":6.3618,"lat":49.4673}]},{"name":"גוטלנד","nameLatin":"Guttland","where":"מרכז ומערב לוקסמבורג","body":"גוטלנד מכסה את המרכז והמערב הכפריים: גבעות מתונות, שדות, חורשות, נחלים, עמקים וטירות, ובהם Valley of the Seven Castles. זהו אזור טוב לטיולי יום ולבסיס קרוב לעיר לוקסמבורג, אך חלש יותר כיעד לטרק רציף ארוך. Guttland.Trails הם לולאות מסומנות, שרבות מהן באורך 5–11 קמ ובקושי קל עד בינוני. הלינה הטבעית היא בכפרים ובעיר לוקסמבורג; המקורות אינם מפרטים עומס או עונה מועדפת. במסלולים מצוין שמזג אוויר רטוב, קרח או רוח יכולים להקשות.","sources":[13,14,15],"trails":[{"name":"Guttland.Trail Fuussepad","nameLatin":"Guttland.Trail Fuussepad","aliases":["Fuussepad","Fox Trail"],"body":"לולאה מגן היער של Steinsel, 11.08 קמ וכ-3:10 שעות, בדרגת קושי בינונית. היא משלבת יער, נחלים, תצורות סלע, שדות ומתחם וילה רומית; המסלול מסומן לביצוע בשני הכיוונים.","sources":[14],"start":[6.1245,49.6775],"wmt":{"type":"relation","id":16251047,"name":"Guttland.Trail Fuussepad","group":"REG","linear":"no"},"line":[[[6.1108,49.6793],[6.108,49.6752],[6.1106,49.6747],[6.1027,49.6716],[6.1015,49.6732],[6.0952,49.6745],[6.0961,49.6756],[6.0939,49.6758],[6.0988,49.6797],[6.0985,49.6847],[6.1011,49.6871],[6.0939,49.6847],[6.0908,49.6858],[6.0952,49.6917],[6.0939,49.6937],[6.0948,49.696],[6.097,49.6966],[6.0952,49.6926],[6.1004,49.6934],[6.1049,49.6893],[6.1059,49.6856],[6.1088,49.6847],[6.1091,49.6833],[6.114,49.6843],[6.1156,49.6829],[6.1133,49.6813],[6.1151,49.6799],[6.1149,49.6775],[6.1124,49.6757],[6.1106,49.6791]]]},{"name":"Guttland.Trail Siwe Brécke-Wee","nameLatin":"Guttland.Trail Siwe Brécke-Wee","aliases":["Siwe Brécke-Wee","Seven Bridges Trail"],"body":"לולאה מ-St Rochus Chapel ב-Reimberg, 5.22 קמ וכ-1:25 שעות, קלה ומתאימה גם למשפחות. היא עוברת ביער ובעמק Schankegriecht, לאורך פלג ועל פני גשרי עץ קטנים; נעלי הליכה ומים מומלצים.","sources":[15],"start":[5.952,49.796],"wmt":{"type":"relation","id":8032747,"name":"Guttland.Trail Siwe Brécke-Wee","group":"LOC","linear":"sorted"},"line":[[[5.9564,49.8095],[5.9497,49.8113],[5.954,49.8089],[5.9538,49.8058],[5.9508,49.804],[5.9509,49.802],[5.9581,49.8006],[5.962,49.8015],[5.9649,49.7994],[5.9648,49.8046],[5.9665,49.8055],[5.9641,49.8073