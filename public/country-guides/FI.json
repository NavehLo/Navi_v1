],[29.414,66.2604],[29.4167,66.2605]],[[29.4012,66.2703],[29.4047,66.2707],[29.4078,66.2696]]]},{"name":"Keroharjun kuiskaus","nameLatin":"Keroharjun kuiskaus","aliases":["Keroharju Hiking Trail"],"body":"מסלול של 17.2 קמ בין אזורי Kuusamo ו-Salla, המתאים ליום ארוך. זהו מסלול ביניים למי שרוצה מרחק משמעותי בלי להשלים את Karhunkierros; לאורך הדרך יש מחסה ומדורה.","sources":[],"start":[29.3147,66.3683],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[28.8652,66.5159],[28.9525,66.1703],[28.9586,66.1516],[28.9764,66.1341],[29.0048,66.1191],[29.0418,66.1076],[29.0849,66.1004],[29.1311,66.0979],[29.1843,66.0973],[29.2305,66.0998],[29.2736,66.107],[29.3106,66.1185],[29.559,66.2038],[29.5874,66.2188],[29.6052,66.2363],[29.6113,66.255],[29.6052,66.2737],[29.5874,66.2912],[29.4694,66.4045],[29.1985,66.5521],[29.1701,66.5671],[29.1331,66.5786],[29.09,66.5858],[29.0438,66.5883],[28.9976,66.5858],[28.9545,66.5786],[28.9175,66.5671],[28.8891,66.5521],[28.8713,66.5346],[28.8652,66.5159]]]],"bbox":[28.8652,66.0973,29.6113,66.5883]},"places":[{"name":"Ruka","lon":29.1311,"lat":66.1703},{"name":"Saarua","lon":29.1843,"lat":66.1697},{"name":"Juuma","lon":29.3881,"lat":66.272},{"name":"Jyrävä","lon":29.4327,"lat":66.255},{"name":"Oulanka Visitor Centre","lon":29.3147,"lat":66.3683},{"name":"Hautajärvi","lon":29.0438,"lat":66.5159}]},{"name":"הוסה","nameLatin":"Hossa National Park","where":"קינואו, סמוך ל-Suomussalmi ו-Kuusamo","body":"הוסה היא רשת נוחה של יערות אורן, רכסי esker ואגמים צלולים, עם שילוב בולט של קניון Julma-Ölkky וציורי הסלע ב-Värikallio. היא מתאימה במיוחד ליום או יומיים, אם כי קיימים מסלולים ארוכים יותר ובקתות פתוחות ובקתות הזמנה. עונת ההליכה היא קיץ ותחילת סתיו; שבילי היום אינם מתוחזקים בחורף. העומס מרוכז ב-Julma-Ölkky ובמוקדי ציורי הסלע. מתאים למשפחות במסלולים הקלים ולמטיילים חזקים במסלולי הקניון; פחות למי שמחפש טרק הררי ארוך וחשוף.","sources":[12,13],"trails":[{"name":"Ölökyn ähkäsy","nameLatin":"Ölökyn ähkäsy","aliases":["Julma-Ölkky Trail"],"body":"לולאה של 9.4 קמ מ-Julma-Ölkky parking area, כחמש שעות, מדורגת קשה. היא מקיפה את אגם הקניון עם עליות, ירידות, קטעים סלעיים וגשר תלוי; אין תחזוקת חורף.","sources":[13],"start":null,"wmt":{"type":"relation","id":10523317,"name":"Ölökyn ähkäsy","group":"LOC","linear":"no"},"line":[[[29.3238,65.5371],[29.3273,65.5387],[29.3272,65.5441],[29.3307,65.5511],[29.3306,65.5538],[29.3267,65.5577],[29.3275,65.5626],[29.3256,65.5636],[29.3216,65.5626],[29.3172,65.5635],[29.3159,65.5627],[29.3063,65.5705],[29.3008,65.5708],[29.3041,65.568],[29.3028,65.5679],[29.3036,65.5671],[29.3195,65.5597],[29.3198,65.5584],[29.3216,65.5588],[29.3242,65.5571]],[[29.3262,65.5557],[29.3263,65.547],[29.3213,65.5418],[29.3231,65.5371]],[[29.3263,65.5525],[29.3232,65.5537],[29.3248,65.5564]]]},{"name":"Ölökyn ylitys","nameLatin":"Ölökyn ylitys","aliases":["Julma-Ölkky Crossing Trail"],"body":"מסלול יום של 5.3 קמ, כשלוש שעות, מ-Julma-Ölkky parking area. הוא כולל גשר תלוי, מדרגות פלדה ועליות וירידות רבות; אין בו שירותים או אתר מדורה, ואינו מתאים לכלבים בקטע המדרגות.","sources":[14],"start":null,"wmt":{"type":"relation","id":10523318,"name":"Ölökyn ylitys","group":"LOC","linear":"yes"},"line":[[[29.3238,65.5371],[29.3273,65.5387],[29.3272,65.5441],[29.3307,65.5511],[29.3306,65.5538],[29.3264,65.5579],[29.3242,65.5571],[29.3269,65.5549],[29.3267,65.5484],[29.324,65.5435],[29.3213,65.5418],[29.3231,65.5371]]]},{"name":"Kokalmus–Laukkujärvi","nameLatin":"Kokalmus–Laukkujärvi","aliases":["Kokalmus - Laukkujärvi"],"body":"קטע הליכה בהוסה בין Kokalmus ל-Laukkujärvi, המתאים לשילוב במסלול רב-יומי בין אגמים ובקתות. יש לבדוק במפת הפארק את הכיוון והחיבור למסלולים האחרים לפני היציאה.","sources":[15],"start":[29.3497,65.4579],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[29.1273,65.57],[29.1339,65.5131],[29.1398,65.4944],[29.1822,65.4392],[29.1995,65.4217],[29.2271,65.4067],[29.263,65.3952],[29.3048,65.388],[29.3497,65.3855],[29.3946,65.388],[29.5635,65.3978],[29.6053,65.405],[29.6412,65.4165],[29.6688,65.4315],[29.6861,65.449],[29.692,65.4677],[29.6861,65.4864],[29.6688,65.5039],[29.6412,65.5189],[29.4233,65.6212],[29.3874,65.6327],[29.3456,65.6399],[29.3007,65.6424],[29.2558,65.6399],[29.214,65.6327],[29.1781,65.6212],[29.1505,65.6062],[29.1332,65.5887],[29.1273,65.57]]]],"bbox":[29.1273,65.3855,29.692,65.6424]},"places":[{"name":"Hossa Visitor Centre","lon":29.5186,"lat":65.4677},{"name":"Julma-Ölkky","lon":29.3277,"lat":65.5495},{"name":"Ölkynperä","lon":29.3007,"lat":65.57},{"name":"Värikallio","lon":29.3073,"lat":65.5131},{"name":"Kokalmus","lon":29.3497,"lat":65.4579}]},{"name":"קולי ואגם פיילינן","nameLatin":"Koli National Park","where":"צפון קרליה, ממערב לאגם Pielinen","body":"קולי הוא אזור גבעות, רכסים, יער עתיק ונופי אגם Pielinen, ולא יעד הרים אלפיני. יש בו כ-80 קמ של שבילים מסומנים, ממסלולי תצפית קצרים ועד Herajärvenkierros הרב-יומי. לנים באוהל באתרי קמפינג, בבקתות הזמנה ובמקומות לינה פרטיים לאורך המסלול הארוך. המסלולים אינם מתוחזקים בחורף. Ukko-Koli והמסלולים הקרובים אליו פופולריים; יתר הלולאה ארוך ושקט יותר. מתאים למי שרוצה טרק יער עם הפרשי גובה; פחות למי שמחפש מרחב wilderness ללא שירותים.","sources":[16,17],"trails":[{"name":"Herajärvenkierros","nameLatin":"Herajärvenkierros","aliases":["Herajärvi Trail","Herajärven kierros"],"body":"לולאת טרק מאתגרת סביב אגם Herajärvi, באורך 30–61 קמ לפי הקטעים הנבחרים. הקטע הצפוני הוא 38.4 קמ והדרומי 31.3 קמ; אפשר ללון באוהל, מחסות ובקתות. המעבורת הידנית ב-Sikosalmi אינה פועלת בחורף.","sources":[17],"start":[29.924,62.9895],"wmt":{"type":"relation","id":5996912,"name":"Herajärven kierros","group":"REG","linear":"no"},"line":[[[29.929,63.0223],[29.9306,63.0219],[29.933,63.0235],[29.9405,63.0194],[29.9422,63.0198],[29.9459,63.0176],[29.9613,63.0119],[29.9647,63.0117],[29.9658,63.0123],[29.9691,63.0107],[29.9753,63.0134],[29.9754,63.0107]],[[29.9757,63.0097],[29.9772,63.0048],[29.979,63.0047]],[[29.9754,63.0107],[29.9757,63.0097]],[[29.9798,63.005],[29.9847,63.0024],[29.9854,62.9995],[29.9881,62.9981],[29.9884,62.997