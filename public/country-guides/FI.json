8],[26.8327,61.1922],[26.8372,61.1905],[26.8379,61.1892]]]}],"shape":{"kind":"hull","polygons":[[[[26.687,61.1879],[26.6883,61.1704],[26.6934,61.1517],[26.7083,61.1342],[26.73,61.1193],[26.7537,61.1043],[26.7845,61.0928],[26.8205,61.0856],[26.8591,61.0831],[26.8977,61.0856],[26.9337,61.0928],[26.9645,61.1043],[26.9882,61.1193],[27.0031,61.1368],[27.0082,61.1555],[27.0031,61.1742],[26.9852,61.2075],[26.9703,61.225],[26.9466,61.24],[26.9158,61.2515],[26.8798,61.2587],[26.8412,61.2612],[26.8026,61.2587],[26.7975,61.2578],[26.7615,61.2506],[26.7307,61.2391],[26.707,61.2241],[26.6921,61.2066],[26.687,61.1879]]]],"bbox":[26.687,61.0831,27.0082,61.2612]},"places":[{"name":"Olhavanvuori","lon":26.8412,"lat":61.1888},{"name":"Olhavanlampi","lon":26.8361,"lat":61.1879},{"name":"Katajavuori","lon":26.8374,"lat":61.1704},{"name":"Kapiavesi","lon":26.8591,"lat":61.1555}]},{"name":"ארכיפלג טורקו","nameLatin":"Archipelago National Park","where":"דרום-מערב פינלנד, בין Nauvo, Korpo ו-Utö","body":"זהו יעד חופי ואיי, לא טרק רציף: ההליכה מתרחשת באיים קטנים ומשולבת במעבורות, סירה או קיאק. Berghamn, Björkö ו-Jurmo מציעים שבילי טבע, חופים סלעיים ואפשרויות לינה מוגבלות. הקיץ הוא העונה המעשית ביותר, כשיש יותר תחבורה ושירותים. לינה אפשרית רק במקומות המורשים, ולעתים אין מי שתייה באי. יש מגבלות נחיתה באיים מסוימים באפריל–יולי להגנת קינון. מתאים ליום–יומיים איטיים ולמי שמתכנן לוגיסטיקה; חלש כיעד לטרק רגלי רציף.","sources":[21,22],"trails":[{"name":"Berghamn Nature Trail","nameLatin":"Berghamn Nature Trail","aliases":["Berghamns naturstig"],"body":"שביל טבע בחלק הצפוני של Berghamn, ליד חוות הדייגים Västerby. מגיעים לאי בסירה או במעבורת; אין מי שתייה באי, ולכן יש להגיע עם מים.","sources":[21,23],"start":[21.793,60.0534],"wmt":null,"line":null},{"name":"Jurmo Walking Trails","nameLatin":"Jurmo Walking Trails","aliases":["Jurmon kävelyreitit"],"body":"רשת שבילי הליכה באי Jurmo, הנגיש בסירה. הקצה המערבי סגור בעונת קינון, 1 באפריל–31 ביולי; המסלולים מתאימים ליום באי ולא לטרק רציף.","sources":[21,22],"start":[21.5929,59.8239],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[21.2267,60.2234],[21.2299,59.7806],[21.2348,59.7619],[21.2492,59.7444],[21.2721,59.7294],[21.302,59.7179],[21.3368,59.7107],[21.3741,59.7082],[21.4114,59.7107],[21.6302,59.754],[21.665,59.7612],[21.6949,59.7727],[21.7178,59.7877],[21.9179,60.0172],[22.0354,60.1563],[22.0498,60.1738],[22.0547,60.1925],[22.0498,60.2112],[22.0354,60.2287],[22.0125,60.2437],[21.9826,60.2552],[21.9478,60.2624],[21.9105,60.2649],[21.3709,60.2958],[21.3336,60.2933],[21.2988,60.2861],[21.2689,60.2746],[21.246,60.2596],[21.2316,60.2421],[21.2267,60.2234]]]],"bbox":[21.2267,59.7082,22.0547,60.2958]},"places":[{"name":"Nauvo","lon":21.9105,"lat":60.1925},{"name":"Korpoström","lon":21.5995,"lat":60.1135},{"name":"Berghamn","lon":21.793,"lat":60.0534},{"name":"Jurmo","lon":21.5929,"lat":59.8239},{"name":"Utö","lon":21.3741,"lat":59.7806},{"name":"Houtskär","lon":21.3709,"lat":60.2234}]},{"name":"נוקסיו והלסינקי רבתי","nameLatin":"Nuuksio National Park","where":"מערבית להלסינקי, בעיקר Espoo ו-Vihti","body":"נוקסיו הוא יער, אגמים, מצוקים ועמקי קרחונים במרחק קצר מהלסינקי. זהו אזור חזק למסלולי יום וללילה באוהל, עם שבילים מסומנים, מים ושירותים סביב Haukkalampi ו-Haltia, אך לא יעד לטרק ארוך. בקיץ ובסתיו הוא נגיש במיוחד, אך אין תחזוקת חורף ברוב שבילי ההליכה. זהו הפארק השלישי בפופולריותו בפינלנד, עם מעל 300,000 ביקורים ב-2024, ולכן כדאי להעדיף אמצע שבוע. מתאים למתחילים ולמי ללא רכב; פחות למי שמחפש בדידות.","sources":[24,25],"trails":[{"name":"Korpinkierros","nameLatin":"Korpinkierros","aliases":["Raven Circuit"],"body":"לולאה של 7.2 קמ, 2.5–4 שעות, מ-Haukkalampi או Siikaniemi. מדורגת בינונית, עם עליות, שורשים, אגמים ואתרי קמפינג; אין תחזוקת חורף והקמפינג מותר רק באתרים המסומנים.","sources":[24],"start":null,"wmt":{"type":"relation","id":2726173,"name":"Korpinkierros","group":"LOC","linear":"no"},"line":[[[24.512,60.2917],[24.497,60.2953],[24.4945,60.2974],[24.4948,60.2988],[24.4902,60.3014],[24.4949,60.3032],[24.5033,60.3044],[24.5033,60.3059],[24.5059,60.3049],[24.5079,60.3052],[24.5091,60.304],[24.5106,60.2978],[24.5214,60.2938],[24.5232,60.2918],[24.5121,60.2917]],[[24.5079,60.3052],[24.5113,60.3062],[24.5147,60.3098],[24.517,60.3097]]]},{"name":"Haukankierros","nameLatin":"Haukankierros","aliases":["Hawk Circuit"],"body":"לולאה של 3.9 קמ, 1.5–2 שעות, מ-Haukkalampi, אך מדורגת קשה בגלל הפרשי הגובה. היא כוללת שבילי יער צרים, מצוקים ועמק Myllypuro; לינה מותרת רק באתר Mustalampi.","sources":[26],"start":null,"wmt":{"type":"relation","id":551822,"name":"Haukankierros","group":"LOC","linear":"yes"},"line":[[[24.517,60.3097],[24.5147,60.3098],[24.5113,60.3062],[24.5062,60.3049],[24.5036,60.3077],[24.5012,60.3077],[24.4986,60.3099],[24.5014,60.3097],[24.5046,60.3146],[24.5095,60.3147],[24.5111,60.3157],[24.5159,60.3132],[24.5179,60.3103],[24.517,60.3097]]]},{"name":"Haltia–Haukkalampi Connecting Trail","nameLatin":"Haltia–Haukkalampi Connecting Trail","aliases":["Haltia-Haukkalampi yhdysreitti"],"body":"שביל חיבור של 4.3 קמ בין Haltia ל-Haukkalampi. הוא מאפשר לשלב תחבורה ושירותים של מרכז הטבע עם מסלולי הפארק, ומתאים במיוחד ליום הליכה ללא רכב.","sources":[25],"start":[24.557,60.2937],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[24.3475,60.3017],[24.3525,60.283],[24.367,60.2655],[24.39,60.2505],[24.4201,60.239],[24.4551,60.2318],[24.5195,60.2238],[24.557,60.2213],[24.5945,60.2238],[24.6295,60.231],[24.6596,60.2425],[24.6652,60.2455],[24.6882,60.2605],[24.7027,60.278],[24.7077,60.2967],[24.7027,60.3154],[24.6882,60.3329],[24.6652,60.3479],[24.5979,60.3789],[24.5678,60.3904],[24.5328,60.3976],[24.4953,60.4001],[24.4578,60.3976],[24.4228,60.3904],[24.3927,60.3789],[24.3697,60.3639],[24.3552,60.3464],[24.3502,60.3277],[24.3475,60.3017]]]],"bbox":[24.3475,60.2213,24.7077,60.4001]},"places":[{"name":"Haltia","lon":24.557,"lat":60.2937},{"name":"Holma-Saarijärvi","lon":24.4926,"lat":60.3017},{"name":"Nuuksio","lon":24.5626,"lat":60.2967},{"name":"Kattila","lon":24.4953,"lat":60.3277}]}],"closing":"לבחירת אזור: לטרק אמיתי של כמה ימים עדיף להתחיל בפאלאס–אילס, אורהו קקונן או Karhunkierros באולנקה. למסלולי יום עם עליות ונוף אגם מתאימים קולי ורפובסי; להליכה נוחה ליד הלסינקי נוקסיו; ולהליכה חופית עם מעבורות ארכיפלג טורקו. ביוני–ספטמבר רוב אזורי ההליכה פתוחים, אך בלפלנד ובקילפיסיארבי יש להביא בחשבון שלג מאוחר ורוח; באולנקה יש להימנע מתקופת ההצפה באביב. בחורף יש לבחור במפורש מסלול סקי או נעלי שלג, ולא להניח ששביל קיץ מתוחזק.","closingSources":[2,4,10,19,22,25],"sources":[{"id":1,"url":"https://www.visitfinland.com/en/articles/tips-for-hiking-and-walking-in-finland/","title":"Hiking in Finland: trails, national parks and tips for every season"},{"id":2,"url":"https://www.visitfinland.com/en/articles/tips-for-hiking-and-walking-in-finland/","title":"Hiking in Finland: trails, national parks and tips for every season"},{"id":3,"url":"https://www.kilpisjarvenladut.fi/en_US/kilpisjarvi-routes","title":"Kilpisjärvi and Käsivarsi summer routes"},{"id":4,"url":"https://www.luontoon.fi/en/trails/hetta-pallas-skiing-trail-enontekio-191018-en","title":"Hetta-Pallas skiing trail"},{"id":5,"url":"https://www.luontoon.fi/en/trails/rautulampi-hiking-trail-sodankyla-15810-en","title":"Rautulampi Hiking Trail"},{"id":6,"url":"https://julkaisut.metsa.fi/wp-content/uploads/sites/2/2021/07/ukk-kiirunapolku-eng.pdf","title":"Kiirunapolku"},{"id":7,"url":"https://www.kilpisjarvenladut.fi/en_US/kilpisjarvi-routes","title":"Kilpisjärvi and Käsivarsi summer routes"},{"id":8,"url":"https://www.kilpisjarvenretkeilykeskus.fi/tietoa-meista/usein-kysytyt-kysymykset.html","title":"Kilpisjärven Retkeilykeskus Q&A"},{"id":9,"url":"https://www.luontoon.fi/en/trails/pieni-karhunkierros-trail-kuusamo-42308-en","title":"Pieni Karhunkierros Trail"},{"id":10,"url":"https://www.luontoon.fi/en/articles/when-to-visit-oulanka-national-park","title":"When to visit Oulanka National Park"},{"id":11,"url":"https://www.luontoon.fi/en/trails/karhunkierros-trail-kuusamo-10791-en/whatsnew/ka