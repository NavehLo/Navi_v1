,[22.1178,37.7013],[22.1045,37.708],[22.099,37.7055],[22.0949,37.7074],[22.0928,37.7031],[22.0931,37.6991],[22.0915,37.6982],[22.0925,37.6935],[22.0906,37.6914],[22.0922,37.6884],[22.0852,37.683],[22.0827,37.6853],[22.0768,37.6868],[22.0792,37.6882],[22.0796,37.6905],[22.077,37.6937],[22.0784,37.6982],[22.0751,37.6985],[22.0711,37.6975],[22.0671,37.6911],[22.0649,37.6922],[22.057,37.6913],[22.054,37.6864],[22.0484,37.686],[22.0445,37.6839],[22.0457,37.6877],[22.0418,37.69],[22.0306,37.682]]]},{"name":"Valtesiniko–Lagkadia","nameLatin":"Valtesiniko–Lagkadia","body":"הקטע השמיני של Menalon Trail מ-Valtesiniko אל Lagkadia: 13.9 קמ וכחמש שעות. זהו יום מלא בתוך הטרק, ולא מסלול קצר למשפחות.","sources":[14],"start":[22.0974,37.7047],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[21.9488,37.5956],[21.9519,37.5769],[21.9609,37.5594],[21.9753,37.5444],[22.0189,37.5049],[22.0377,37.4934],[22.0596,37.4862],[22.0831,37.4837],[22.1066,37.4862],[22.1285,37.4934],[22.1473,37.5049],[22.1617,37.5199],[22.2277,37.5906],[22.2613,37.6342],[22.2703,37.6517],[22.2734,37.6704],[22.2749,37.692],[22.2718,37.7107],[22.2628,37.7282],[22.2484,37.7432],[22.2296,37.7547],[22.2077,37.7619],[22.1842,37.7644],[22.1607,37.7619],[22.1033,37.7478],[22.0814,37.7406],[22.0626,37.7291],[21.9753,37.6468],[21.9609,37.6318],[21.9519,37.6143],[21.9488,37.5956]]]],"bbox":[21.9488,37.4837,22.2749,37.7644]},"places":[{"name":"Stemnitsa","lon":22.0831,"lat":37.5561},{"name":"Dimitsana","lon":22.0395,"lat":37.5956},{"name":"Zygovisti","lon":22.0795,"lat":37.5888},{"name":"Elati","lon":22.1491,"lat":37.6268},{"name":"Vytina","lon":22.1827,"lat":37.6704},{"name":"Nymfasia","lon":22.1842,"lat":37.692},{"name":"Magouliana","lon":22.1268,"lat":37.6779}]},{"name":"אנדרוס","nameLatin":"Andros","where":"האיים הקיקלאדיים, צפון הים האגאי הדרומי","body":"אנדרוס היא האי המתאים ביותר ביוון למי שמחפש רשת שבילים מסודרת באי: דרכים עתיקות, סמטאות אבן ושבילים בין כפרים, נחלים ומנזרים. Andros Route הוא ציר של כ-100 קמ בעשרה ימי הליכה, בתוך רשת כוללת של כ-180 קמ. העונות המומלצות הן מרץ–יוני וספטמבר–נובמבר, ויש לבדוק מצב שבילים באתר הרשמי כי מזג האוויר משפיע על עבירותם. הלינה היא בכפרים ובעיירות; מתאים לטרק אי של כשבוע עד עשרה ימים, פחות למי שמבקש בידוד הררי.","sources":[16,17],"trails":[{"name":"Andros Route","nameLatin":"Andros Route","body":"מסלול האורך של אנדרוס, מ-Vori אל Korthi, באורך כ-100 קמ ובעשרה קטעים יומיים. רמת הקושי נעה מהליכות קלות של 1–2 שעות ועד ימים תובעניים של 6–8 שעות; נעלי הליכה מונעות החלקה, מים ומפת שביל או היישומון הרשמי מומלצים.","sources":[16],"start":[24.8109,35.0677],"wmt":{"type":"relation","id":14602499,"name":"Andros Route C2","group":"LOC","linear":"yes"},"line":[[[24.9247,37.8424],[24.9215,37.8413],[24.9211,37.8396]]]},{"name":"Arni–Apikia","nameLatin":"Arni–Apikia","body":"היום הרביעי של Andros Route, מ-Arni דרך Vourkoti אל Apikia: 10.3 קמ ו-3.5–4 שעות. המקור מדרג אותו בינוני עד קשה, ולכן עדיף למטיילים שכבר רגילים ליום הליכה מלא.","sources":[17],"start":[24.8479,37.8589],"wmt":null,"line":null},{"name":"Vrachnou–Ormos Korthiou","nameLatin":"Vrachnou–Ormos Korthiou","body":"היום התשיעי של Andros Route, מ-Vrachnou אל Ormos Korthiou: 9.8 קמ ו-4–4.5 שעות. הקושי המדווח הוא בינוני, והוא מתאים גם כקטע עצמאי בתוך טיול באי.","sources":[17],"start":[22.8062,37.5685],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[24.6466,37.8846],[24.6497,37.8659],[24.6588,37.8484],[24.6732,37.8334],[24.6921,37.8219],[24.7415,37.7935],[24.905,37.7104],[24.9269,37.7032],[24.9505,37.7007],[24.9741,37.7032],[24.996,37.7104],[25.0149,37.7219],[25.0293,37.7369],[25.0384,37.7544],[25.0415,37.7731],[25.0384,37.7918],[25.0227,37.8562],[25.0136,37.8737],[24.9992,37.8887],[24.9803,37.9002],[24.9555,37.9129],[24.9335,37.9235],[24.9116,37.9307],[24.7612,37.9545],[24.7376,37.957],[24.714,37.9545],[24.6921,37.9473],[24.6732,37.9358],[24.6588,37.9208],[24.6497,37.9033],[24.6466,37.8846]]]],"bbox":[24.6466,37.7007,25.0415,37.957]},"places":[{"name":"Gavrio","lon":24.7376,"lat":37.8846},{"name":"Batsi","lon":24.787,"lat":37.8562},{"name":"Arni","lon":24.8479,"lat":37.8589},{"name":"Vourkoti","lon":24.888,"lat":37.8608},{"name":"Apikia","lon":24.91,"lat":37.8502},{"name":"Chora Andros","lon":24.9348,"lat":37.8375},{"name":"Ormos Korthiou","lon":24.9505,"lat":37.7731}]},{"name":"קורפו","nameLatin":"Corfu","where":"האיים היוניים, מערב יוון","body":"Corfu Trail הוא טרק אי ארוך יחסית, החוצה את קורפו מדרום לצפון דרך צמחייה, כפרים, מטעי זיתים, חופים ורכסי ההר. אורכו 178 קמ מ-Asprokavos אל Agios Spyridon, והוא מחולק ל-11 קטעים; אפשר ללכת אותו עצמאית או במסגרת מודרכת. לינה אפשרית ב-Bed & Breakfast ביישובים לאורך הדרך, למשל Pelekas, Liapades, Agios Georgios ו-Barbati. האזור מתאים למי שמעדיף טרק מדורג עם לינות יישוביות; חלק מהקטעים כוללים עליות תלולות ושבילים קשים, ולכן אינו כולו קל.","sources":[18,19],"trails":[{"name":"Corfu Trail","nameLatin":"Corfu Trail","body":"טרק האורך מ-Asprokavos אל Agios Spyridon, 178 קמ. האתר מחלק אותו ל-11 קטעים; אפשר לבצע אותו כטרק רב-יומי עם לינה ביישובים, או לבחור רק את החלק הדרומי או הצפוני.","sources":[18,19],"start":[20.1109,39.3617],"wmt":{"type":"relation","id":1659988,"name":"Corfu Trail","group":"REG","linear":"yes"},"line":[[[20.1137,39.3777],[20.1121,39.3729],[20.1095,39.3714],[20.1135,39.3678],[20.1118,39.3669],[20.1105,39.3628],[20.1059,39.3651],[20.1074,39.3658],[20.1055,39.3682],[20.1016,39.3659],[20.0909,39.3683],[20.0862,39.3663],[20.084,39.3671],[20.0856,39.3674],[20.0865,39.3761],[20.0893,39.3773],[20.0924,39.3765],[20.0936,39.3796],[20.0924,39.3809],[20.0934,39.3835],[20.0875,39.3857],[20.0915,39.3914],[20.091,39.3934],[20.0829,39.3948],[20.0868,39.4],[20.0867,39.4164],[20.0827,39.4184],[20.0829,39.4206],[20.075,39.4227],[20.0754,39.4238],[20.0694,39.4233],[20.0656,39.4245],[20.0638,39.4235],[20.0644,39.4189],[20.0604,39.4174],[20.0575,39.414]],[[20.0579,39.4133],[20.0569,39.4094],[20.0452,39.4068],[20.0404,39.4031],[20.0373,39.4034],[20.0344,39.4062],[20.0315,39.4061],[20.0307,39.4033],[20.027,3