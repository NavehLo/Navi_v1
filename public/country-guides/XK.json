,[20.2503,42.4868],[20.2501,42.495],[20.2577,42.4909],[20.2602,42.4933],[20.2613,42.4929],[20.2596,42.4897],[20.2636,42.4842],[20.2699,42.4825],[20.2759,42.4765],[20.2782,42.4765]],[[20.2817,42.5412],[20.2778,42.5426],[20.2756,42.5412],[20.2717,42.5418],[20.2713,42.5393],[20.2684,42.539],[20.2647,42.5427],[20.2621,42.5428],[20.2609,42.5452],[20.2545,42.5426],[20.243,42.545],[20.2437,42.5463],[20.2419,42.5481],[20.2386,42.5465],[20.2337,42.5466],[20.2242,42.5498],[20.2144,42.5507],[20.2103,42.5523],[20.1945,42.5507],[20.1849,42.5517],[20.181,42.5558],[20.1754,42.5549],[20.1748,42.5522],[20.1635,42.56],[20.1553,42.5618],[20.1477,42.5616],[20.1357,42.5581],[20.1333,42.5511],[20.1277,42.5468],[20.1289,42.5443],[20.1253,42.5416],[20.1257,42.5376],[20.1219,42.531]]]}],"shape":{"kind":"hull","polygons":[[[[20.0375,42.5307],[20.0408,42.512],[20.0505,42.4945],[20.066,42.4795],[20.0862,42.468],[20.1161,42.4565],[20.2286,42.4134],[20.2522,42.4062],[20.2774,42.4037],[20.3026,42.4062],[20.3262,42.4134],[20.3464,42.4249],[20.3619,42.4399],[20.4308,42.511],[20.4405,42.5285],[20.4438,42.5472],[20.4405,42.5659],[20.4308,42.5834],[20.4153,42.5984],[20.3951,42.6099],[20.3715,42.6171],[20.3463,42.6196],[20.1406,42.6053],[20.1154,42.6028],[20.0918,42.5956],[20.0862,42.5934],[20.066,42.5819],[20.0505,42.5669],[20.0408,42.5494],[20.0375,42.5307]]]],"bbox":[20.0375,42.4037,20.4438,42.6196]},"places":[{"name":"Deçan","lon":20.2882,"lat":42.5402},{"name":"Junik","lon":20.2774,"lat":42.4761},{"name":"Lumbardh i Deçanit","lon":20.3463,"lat":42.5472},{"name":"Gropa e Erenikut","lon":20.1649,"lat":42.5192},{"name":"Gjeravica","lon":20.1406,"lat":42.5329},{"name":"Liqeni i Gjeravicës","lon":20.135,"lat":42.5307}]},{"name":"הרי שאר: Brezovicë, Prevalla ו-Luboten","nameLatin":"Šar Mountains","where":"דרום קוסובו, בין Štrpce לפריזרן","body":"החלק הצפוני של הרי שאר הוא אזור של רמות מרעה, מסלולי סקי שהופכים לשבילים בקיץ, רכסים גבוהים ואגמים. Brezovicë היא בסיס הגישה הנוח ביותר, ואילו Prevalla מחברת למסלולים לכיוון פריזרן ודרומה. הקיץ ותחילת הסתיו מתאימים להליכה; בחורף האזור מתפקד בעיקר כמרחב סקי. המסלולים כאן מתאימים למטיילי יום חזקים ולטרקים לאורך High Scardus Trail, אך חשיפה, ערפל ותנאי הרכס אינם מתאימים למי שאינו מיומן בניווט הררי.","sources":[12,13,14],"trails":[{"name":"Ljuboten מ-Brezovicë","nameLatin":"Ljuboten from Brezovica","aliases":["Luboten from Brezovica","Ljuboten Peak"],"body":"הלוך ושוב מ-Brezovicë אל Luboten: 14.57 מייל, כ-10:59 שעות, 5,735 רגל עלייה, ודירוג קשה. זהו יום ארוך עם עלייה משמעותית, המתאים למטיילים מנוסים ובכושר גבוה.","sources":[12],"start":[21.0336,42.1822],"wmt":null,"line":null},{"name":"Brezovicë Ridge Hike","nameLatin":"Brezovica Hike","aliases":["Brezovica Ridge Walk"],"body":"מסלול יום מאזור מלונות הסקי של Brezovicë על דרכי שירות ושבילי רועים אל הרכסים. האורך המשוער הוא כ-15 קמ הלוך ושוב; המסלול מתואר כבינוני, אך משכו משתנה מחצי יום ליום מלא לפי נקודת הסיבוב.","sources":[13],"start":[21.0336,42.1822],"wmt":null,"line":null},{"name":"High Scardus Trail, Brezovicë–Prevallë","nameLatin":"High Scardus Trail Stage 03","aliases":["Brezovica Ski Resort to Prevallac","High Scardus Stage 3"],"body":"מקטע 3 של High Scardus Trail יוצא מאתר הסקי Brezovicë ומסתיים ב-Prevallë. הוא חלק משביל ארוך בן 20 מקטעי יום החוצה מקוסובו לאלבניה ולצפון מקדוניה, ולכן מתאים בעיקר כחלק מטרק רב-יומי עם לוגיסטיקת לינה.","sources":[14],"start":[21.0336,42.1822],"wmt":null,"line":null},{"name":"High Scardus Trail, Prevallë–Gornje Ljubinje","nameLatin":"High Scardus Trail Stage 04","aliases":["Prevalla to Gornje Ljubinje","High Scardus Stage 4"],"body":"מקטע 4 של High Scardus Trail מ-Prevallë אל Gornje Ljubinje. הוא המשך טבעי למקטע Brezovicë–Prevallë, ומתאים למי שמחפש רצף הליכה של כמה ימים ולא טיול כוכב קצר.","sources":[14],"start":[20.9619,42.1761],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[20.7659,42.1447],[20.7692,42.126],[20.7789,42.1085],[20.7943,42.0935],[20.8144,42.082],[20.8378,42.0748],[20.8629,42.0723],[20.888,42.0748],[21.2831,42.1582],[21.3065,42.1654],[21.3266,42.1769],[21.342,42.1919],[21.3517,42.2094],[21.355,42.2281],[21.3517,42.2468],[21.342,42.2643],[21.3266,42.2793],[21.3065,42.2908],[21.2831,42.298],[21.258,42.3005],[21.2329,42.298],[21.094,42.2767],[20.9368,42.246],[20.9134,42.2388],[20.8144,42.2074],[20.7943,42.1959],[20.7789,42.1809],[20.7692,42.1634],[20.7659,42.1447]]]],"bbox":[20.7659,42.0723,21.355,42.3005]},"places":[{"name":"Brezovicë","lon":21.0336,"lat":42.1822},{"name":"Prevallë","lon":20.9619,"lat":42.1761},{"name":"Luboten","lon":21.1191,"lat":42.2068},{"name":"Liqeni i Livadicës","lon":21.0733,"lat":42.1908},{"name":"Gornje Ljubinje","lon":20.8629,"lat":42.1447},{"name":"Kaçanik","lon":21.258,"lat":42.2281}]},{"name":"דראגאש, גורה ואופויה","nameLatin":"Dragash","where":"דרום קוסובו, בפינת הגבול עם אלבניה וצפון מקדוניה","body":"דראגאש היא הקצה הדרומי והפחות מפותח של הרי שאר בקוסובו, סביב הכפרים Brod ו-Restelicë. אופי ההליכה הוא מרעה גבוה, אגמים ורכסים, עם שבילים ששימשו תושבים ועדרים; ארבעה שבילים מסומנים באורך כולל של 16 קמ. יש אפשרויות קמפינג, בקתת הרים, B&B ב-Brod ומלונות באזור, אבל במסלולים הארוכים מומלץ מדריך לקבוצות. האזור מתאים למטיילים שמעדיפים שבילים שקטים והליכה ארוכה; פחות למי שמחפש תשתית צפופה או סימון רציף.","sources":[15,16,17],"trails":[{"name":"Wild Goat Trail","nameLatin":"Wild Goat Trail","aliases":["Trail No. 5","Brod–Skarpa"],"body":"מסלול של 21 קמ מ-Brod, בגובה פתיחה של כ-1,400 מ', אל מעבר ישן, פסגה בגובה 2,400 מ', White Lake ו-Skarpa בגובה 2,474 מ'. הדרוג הוא קשה מאוד; האתר ממליץ לצאת מוקדם בקיץ ולהיעזר במדריך לקבוצות.","sources":[16],"start":[20.706,41.9917],"wmt":null,"line":null},{"name":"Brod–Shutman Lake–Restelicë","nameLatin":"Brod–Shutman Lake–Restelica","aliases":["Shutman Lake Trail","Liqeni i Shutmanit"],"body":"מסלול מ-Brod אל Shutman Lake: 10 קמ ו-6–7 שעות, מגובה 1,400 מ' אל כ-2,115 מ'. אפשר להמשיך ביום נוסף מן האגם ל-Restelicë, 5 קמ; האגם מוגדר נקודת קמפינג.","sources":[17],"start":[20.706,41.9917],"wmt":null,"line":null},{"name":"Rudoka e Madhe מ-Hotel Arxhena","nameLatin":"Rudoka e Madhe from Hotel Arxhena","aliases":["Maja e Njerit","Great Rudoka"],"body":"לולאה מתועדת מ-Hotel Arxhena ליד Brod אל Rudoka e Madhe: 12.82 מייל, 4,075 רגל עלייה, 7:32 שעות ודירוג קשה. פסגת Rudoka e Madhe היא בגובה 2,658 מ', ולכן זהו מסלול יום ארוך וגבוה.","sources":[18,19],"start":[20.711,41.9652],"wmt":null,"line":null},{"name":"Brod–Gjinibeg–Trepeznica–Arxhena","nameLatin":"Brod–Gjinibeg–Trepeznica–Arxhena","aliases":["Brod to Arxhena Traverse"],"body":"מסלול חד-כיווני מ-Brod דרך Gjinibeg ו-Trepeznica אל Arxhena: 15.8 קמ, 1,408 מ' עלייה, כ-8:13 שעות ודירוג קשה מאוד. מתאים למטיילים חזקים בלבד וליום יציב מבחינת מזג אוויר.","sources":[20],"start":[20.706,41.9917],"wmt":null,"line":null}],"shape":{"kind":"units","polygons":[[[[20.567,41.873],[20.562,41.9],[20.599,41.961],[20.552,42.074],[20.614,42.125],[20.688,42.135],[20.767,42.127],[20.785,42.082],[20.755,42.043],[20.742,41.971],[20.75,41.907],[20.723,41.867],[20.681,41.844],[20.643,41.874],[20.602,41.85],[20.567,41.873]]]],"bbox":[20.552,41.844,20.785,42.135]},"places":[{"name":"Dragash","lon":20.6534,"lat":42.0616},{"name":"Brod","lon":20.706,"lat":41.9917},{"name":"Restelicë","lon":20.67,"lat":41.9434},{"name":"Liqeni i Shutmanit","lon":20.7344,"lat":41.9202},{"name":"Koritnik","lon":20.5736,"lat":42.085}]},{"name":"קניון ומפלי Mirusha","nameLatin":"Mirusha Waterfalls","where":"מרכז-מערב קוסובו, בין Klina, Malishevë ו-Rahovec","body":"Mirusha הוא אזור יום קטן ולא יעד לטרק הרים ארוך: נהר החוצה קניון גיר ויוצר שרשרת אגמים ומפלים. המסלולים לאורך הקניון כוללים שבילים קלים לצד מקטעי סלע והשתחלות, והעונה המומלצת היא מאי–ספטמבר. המקום עמוס יותר בסופי שבוע, במיוחד בקיץ, ושקט יותר בימי חול; אחרי גשם הסלעים חלקים. הלינה אינה חלק מהחוויה המקובלת כאן, ולכן עדיף לשלבו כטיול יום בדרך בין פרישטינה, Pejë וג'קובה.","sources":[21,22],"trails":[{"name":"Mirusha Waterfalls Trail","nameLatin":"Mirusha Waterfalls Trail","aliases":["Mirusha Canyon Trail","Ujëvarat e Mirushës"],"body":"הליכה מחניית הכניסה אל המפלים והאגמים בקניון Mirusha. מקור אחד מתאר טיול של כחצי יום והליכה קצרה מן החניה; השבילים בין האגמים נעים מקלים ועד מקטעי scrambling. יש להיזהר מסלע חלק אחרי גשם.","sources":[21],"start":[20.7142,42.4968],"wmt":null,"line":null},{"name":"Mirusha Park Entrance–Base","nameLatin":"Mirusha Park Entrance to Base","aliases":["Mirusha Waterfalls and Canyon Trail"],"body":"מסלול של 12 קמ, כ-3 שעות, מ-Mirusha Park Entrance אל בסיס הקניון; דירוג הקושי שפורסם הוא קל עד בינוני. הוא מתאים לטיול יום ולא לטרק רב-יומי, אף שהמסלול עובר בשטח קניוני ולאורך אגמים ומפלים.","sources":[22],"start":[20.7142,42.4968],"wmt":null,"line":null}],"shape":{"kind":"hull","polygons":[[[[20.4786,42.618],[20.482,42.5993],[20.5586,42.3812],[20.5683,42.3637],[20.5838,42.3487],[20.604,42.3372],[20.6275,42.33],[20.6527,42.3275],[20.6779,42.33],[20.7014,42.3372],[20.7216,42.3487],[20.8119,42.4326],[20.8274,42.4476],[20.8371,42.4651],[20.8405,42.4838],[20.8371,42.5025],[20.8274,42.52],[20.8119,42.535],[20.645,42.6692],[20.6248,42.6807],[20.6013,42.6879],[20.5761,42.6904],[20.5509,42.6879],[20.5274,42.6807],[20.5072,42.6692],[20.4917,42.6542],[20.482,42.6367],[20.4786,42.618]]]],"bbox":[20.4786,42.3275,20.8405,42.6904]},"places":[{"name":"Mirushë","lon":20.7142,"lat":42.4968},{"name":"Gremnik","lon":20.5895,"lat":42.5833},{"name":"Malishevë","lon":20.743,"lat":42.4838},{"name":"Klina","lon":20.5761,"lat":42.618},{"name":"Rahovec","lon":20.6527,"lat":42.3999}]}],"closing":"לבחירה לפי עונה ומאמץ: לטרק רב-יומי ולפסגות גבוהות בחרו ברוגובה או בדצ'אני–Gjeravica, בעיקר מיוני ועד תחילת אוקטובר ובהיערכות להיתרי גבול. לשביל ארוך בדרום בחרו בהרי שאר וב-High Scardus; לדראגאש יש אופי מבודד יותר ותשתית דלילה יותר. Mirusha מתאימה ליום הליכה קצר יחסית באביב, בקיץ או בתחילת הסתיו, ולא כתחליף לטרק הררי.","closingSources":[5,7,14,21],"sources":[{"id":1,"url":"https://www.summitbalkans.com/blog/kosovo-hiking-guide-best-trails","title":"Kosovo Hiking Guide 2025: 7 Best Trails & Mountains"},{"id":2,"ur