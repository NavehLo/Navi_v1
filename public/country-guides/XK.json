31],[19.8915,42.4656],[19.8834,42.4734],[19.8865,42.4877],[19.8891,42.4896],[19.8898,42.4953],[19.894,42.4989],[19.8938,42.5021],[19.8981,42.5033],[19.9033,42.5015],[19.9111,42.5011],[19.918,42.5032],[19.9254,42.5],[19.9366,42.5002],[19.9599,42.4934]],[[20.1568,42.7277],[20.156,42.7277]],[[20.0357,42.6128],[20.0413,42.6129]]]},{"name":"Via Dinarica Kosovo, מקטע Pejë–Lipë","nameLatin":"Via Dinarica Kosovo Stage 01","aliases":["Via Dinarica Stage 1","Pejë to Lipë"],"body":"מקטע היוצא ממרכז Pejë אל הכפר Lipë, דרך שבילים טבעיים, יערות אורן ואזור Maja e Zezë. זהו חלק מן הסימון המקומי של Via Dinarica; לינה אפשרית בפץ' לפני היציאה.","sources":[8],"start":[20.2886,42.6594],"wmt":{"type":"relation","id":16718686,"name":"Via Dinarica Kosovo - Stage 1","group":"REG","linear":"yes"},"line":[[[20.2885,42.659],[20.2888,42.6612],[20.286,42.6645],[20.2897,42.6717],[20.2854,42.6713],[20.2821,42.6771],[20.2838,42.6816],[20.2823,42.6854],[20.2777,42.6893],[20.2802,42.6919],[20.2814,42.6972],[20.2837,42.6961],[20.2877,42.6998],[20.2827,42.7009],[20.2814,42.7001],[20.2804,42.7013],[20.2779,42.7004],[20.2746,42.7026],[20.2779,42.704],[20.2759,42.7042],[20.2808,42.7083],[20.2794,42.7127]]]}],"shape":{"kind":"units","polygons":[[[[20.183,42.743],[20.208,42.763],[20.218,42.803],[20.319,42.824],[20.344,42.707],[20.403,42.676],[20.457,42.668],[20.488,42.63],[20.467,42.581],[20.503,42.525],[20.419,42.548],[20.365,42.535],[20.324,42.586],[20.278,42.581],[20.201,42.602],[20.185,42.615],[20.193,42.633],[20.139,42.635],[20.036,42.708],[20.027,42.743],[20.076,42.773],[20.183,42.743]]]],"bbox":[20.027,42.525,20.503,42.824]},"places":[{"name":"Pejë","lon":20.2886,"lat":42.6594},{"name":"Gryka e Rugovës","lon":20.1559,"lat":42.6962},{"name":"Kuqishtë","lon":20.0767,"lat":42.6945},{"name":"Bogë","lon":20.0544,"lat":42.742},{"name":"Liqenat","lon":20.0909,"lat":42.6685},{"name":"Hajla","lon":20.1337,"lat":42.7597}]},{"name":"דצ'אני, ג'וניק ו-Gjeravica","nameLatin":"Gjeravica and Deçan","where":"מערב קוסובו, לאורך גבול אלבניה","body":"החלק הדרום-מערבי של Bjeshkët e Nemuna הוא אזור אלפיני גבוה יותר, עם גישה מדצ'אני, ג'וניק ועמק Erenik. מוקדו הוא Gjeravica, בגובה 2,656 מ', הפסגה הגבוהה בקוסובו. זהו אזור למטיילים בעלי כושר וניסיון בשטח הררי: העלייה כוללת לעתים רכס סלעי וחשוף, והגישה לכמה תחילות מסלול היא בדרך עפר או ברכב 4X4. לטרקים ארוכים ניתן לשלב את Peaks of the Balkans ואת Via Dinarica; חציות גבול מחייבות אישור מראש.","sources":[9,10,11],"trails":[{"name":"Lumbardh–Gjeravica","nameLatin":"Gjeravica from Lumbardh","aliases":["Gjeravica Summit","Maja e Gjeravicës"],"body":"עלייה מהכפר Lumbardh לפסגת Gjeravica. העלייה והירידה נמשכות בדרך כלל 8–10 שעות וכוללות כ-1,600 מ' טיפוס; הסיום הוא הליכה סלעית חשופה על רכס, ולכן לא מומלץ ברוח חזקה או בתנאים רטובים.","sources":[9],"start":[20.3463,42.5472],"wmt":null,"line":null},{"name":"לולאת Gjeravica מ-Gropa e Erenikut","nameLatin":"Gjeravica Summit Loop","aliases":["Gjeravica Peak Loop","Gropa e Erenikut to Gjeravica"],"body":"לולאה של 12.3 קמ מ-Gropa e Erenikut לפסגה ובחזרה, עם 890 מ' עלייה וכ-5:35 שעות לפי המסלול המתועד. הדירוג קשה ודורש כושר טוב, בטחון בצעד וניסיון אלפיני; יש קטעים טכניים שעלולים להיות מסוכנים.","sources":[10],"start":[20.1649,42.5192],"wmt":null,"line":null},{"name":"Dobërdol–Gjeravica–Gacaferi","nameLatin":"Dobërdol–Gjeravica–Gacaferi","aliases":["Peaks of the Balkans Gjeravica variant"],"body":"וריאנט של Peaks of the Balkans מדוברדול אל Gjeravica וממנה ל-Gacaferi: כ-19 קמ, כ-1,134 מ' עלייה ו-8–9 שעות. המסלול עובר מאלבניה לקוסובו שלא דרך מעבר כביש רגיל, ולכן נדרש אישור חציית גבול.","sources":[11],"start":[20.3838,42.6096],"wmt":null,"line":null},{"name":"Via Dinarica Kosovo, דצ'אני","nameLatin":"Via Dinarica Kosovo","aliases":["Via Dinarica Deçan section"],"body":"קטעי הסיום של Via Dinarica Kosovo מגיעים לאגמים שמעל דצ'אני; כל החלק הקוסוברי כולל 13 מקטעים בהרי Bjeshkët e Nemuna. זהו מסלול רב-יומי, ולא מסלול יום בודד; יש לתכנן לינה וניווט בין המקטעים.","sources":[3],"start":[20.2882,42.5402],"wmt":{"type":"relation","id":16501210,"name":"Via Dinarica Kosovo","group":"REG","linear":"no"},"line":[[[20.0163,42.7649],[20.0231,42.7667],[20.0256,42.7652]],[[20.0088,42.7502],[20.0112,42.761],[20.0149,42.762],[20.0164,42.7641]],[[20.2885,42.659],[20.2888,42.6612],[20.286,42.6645],[20.2897,42.6717],[20.2854,42.6713],[20.2821,42.6771],[20.2838,42.6816],[20.2823,42.6854],[20.2777,42.6893],[20.2802,42.6919],[20.2814,42.6972],[20.2837,42.6961],[20.2877,42.6998],[20.2827,42.7009],[20.2814,42.7001],[20.2804,42.7013],[20.2779,42.7004],[20.2753,42.7016],[20.2752,42.7034],[20.2779,42.704],[20.2759,42.7042],[20.2808,42.7083],[20.2793,42.7134],[20.272,42.7164],[20.2736,42.7185],[20.269,42.7222],[20.2691,42.7266],[20.2661,42.7271],[20.2649,42.7295],[20.2597,42.7326],[20.2597,42.7339],[20.2705,42.7404],[20.2723,42.7471],[20.2653,42.7495],[20.2569,42.7497],[20.2436,42.7568],[20.2402,42.7547],[20.2351,42.7559],[20.2305,42.7596],[20.2242,42.7545],[20.2122,42.7539],[20.2057,42.7503],[20.2007,42.75],[20.1998,42.7472],[20.193,42.7457],[20.1883,42.7487],[20.1818,42.7494],[20.1743,42.7528],[20.1679,42.7538],[20.1638,42.7519],[20.1599,42.7521],[20.1465,42.749],[20.1487,42.7532],[20.1473,42.7543],[20.1262,42.7623],[20.1191,42.762],[20.1014,42.7702],[20.099,42.7705],[20.098,42.7691],[20.0894,42.7694],[20.0842,42.7724],[20.0774,42.7741],[20.0741,42.7769],[20.067,42.7763],[20.0606,42.7792],[20.051,42.7762],[20.0475,42.7734],[20.0432,42.7745],[20.0336,42.7689],[20.0329,42.765],[20.0245,42.7652],[20.0232,42.7667],[20.0171,42.7657],[20.015,42.7621],[20.0112,42.761],[20.0084,42.7531],[20.0096,42.7524],[20.0088,42.7473],[20.0067,42.7465],[20.0097,42.7456],[20.011,42.7415],[20.0165,42.7355],[20.0145,42.7293],[20.0168,42.7265],[20.0225,42.7228],[20.0321,42.7206],[20.039,42.7159],[20.0416,42.7133],[20.0388,42.7142],[20.0428,42.7105],[20.0491,42.71],[20.0478,42.7086],[20.0488,42.7078],[20.0529,42.7075]],[[20.0256,42.7652],[20.0281,42.7658]],[[20.0529,42.7075],[20.0552,42.7075],[20.0558,42.7055],[20.0449,42.6